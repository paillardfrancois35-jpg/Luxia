root = true

[*]
charset = utf-8
indent_style = space
indent_size = 4
insert_final_newline = true
trim_trailing_whitespace = true

[*.{json,props,targets,csproj,slnx,xml,axaml,yml}]
indent_size = 2

[*.md]
trim_trailing_whitespace = false

[*.cs]
# Organisation
csharp_style_namespace_declarations = file_scoped:warning
dotnet_sort_system_directives_first = true
csharp_using_directive_placement = outside_namespace:warning

# Style
csharp_prefer_braces = true:warning
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_for_built_in_types = true:suggestion
csharp_style_var_elsewhere = true:suggestion
csharp_style_expression_bodied_methods = when_on_single_line:suggestion
csharp_style_expression_bodied_properties = true:suggestion
dotnet_style_readonly_field = true:warning

# Nommage : champs privés en _camelCase
dotnet_naming_rule.private_fields.symbols = private_fields
dotnet_naming_rule.private_fields.style = underscore_camel
dotnet_naming_rule.private_fields.severity = warning
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.underscore_camel.capitalization = camel_case
dotnet_naming_style.underscore_camel.required_prefix = _

dotnet_naming_rule.private_const.symbols = private_const
dotnet_naming_rule.private_const.style = pascal
dotnet_naming_rule.private_const.severity = warning
dotnet_naming_symbols.private_const.applicable_kinds = field
dotnet_naming_symbols.private_const.applicable_accessibilities = private
dotnet_naming_symbols.private_const.required_modifiers = const
dotnet_naming_style.pascal.capitalization = pascal_case

dotnet_naming_rule.private_static_readonly.symbols = private_static_readonly
dotnet_naming_rule.private_static_readonly.style = pascal
dotnet_naming_rule.private_static_readonly.severity = warning
dotnet_naming_symbols.private_static_readonly.applicable_kinds = field
dotnet_naming_symbols.private_static_readonly.applicable_accessibilities = private
dotnet_naming_symbols.private_static_readonly.required_modifiers = static, readonly

# Analyseurs : écarts assumés
# CA1303 : l'interface est uniquement en français, pas de ressources localisées (D3).
dotnet_diagnostic.CA1303.severity = none
# CA1848 : délégués LoggerMessage non exigés hors code temps réel.
dotnet_diagnostic.CA1848.severity = suggestion
dotnet_diagnostic.CA1873.severity = suggestion

[tests/**.cs]
# Noms de tests Methode_Condition_Resultat (doc 03 §6).
dotnet_diagnostic.CA1707.severity = none
# Méthodes de test : pas de ConfigureAwait.
dotnet_diagnostic.CA2007.severity = none
dotnet_diagnostic.CA1515.severity = none
