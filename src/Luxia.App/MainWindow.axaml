<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Luxia.App.ViewModels"
        xmlns:console="using:Luxia.UI.Modules.Console"
        xmlns:outputs="using:Luxia.UI.Modules.Outputs"
        xmlns:library="using:Luxia.UI.Modules.Library"
        xmlns:installation="using:Luxia.UI.Modules.Installation"
        xmlns:simulator="using:Luxia.UI.Modules.Simulator"
        xmlns:scenes="using:Luxia.UI.Modules.Scenes"
        x:Class="Luxia.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Icon="avares://LuXia/Assets/luxia.ico"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600"
        WindowStartupLocation="CenterScreen"
        WindowState="Maximized">
  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Projet">
        <MenuItem Header="_Nouveau…" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="_Ouvrir…" Command="{Binding OpenProjectCommand}" />
        <Separator />
        <MenuItem Header="_Relire les scènes et palettes" Command="{Binding ReloadShowDataCommand}"
                  ToolTip.Tip="Reprend le contenu modifié à côté de l'application (IA de conception, GEN-133), sans rouvrir le projet" />
        <MenuItem Header="_Importer des scènes…" Command="{Binding ImportScenesCommand}"
                  ToolTip.Tip="Ajoute les scènes d'un fichier (IA de conception) sans rien écraser (GEN-133)" />
        <MenuItem Header="_Problèmes du projet…" Command="{Binding ShowProjectProblemsCommand}" />
      </MenuItem>
      <MenuItem Header="_Aide">
        <MenuItem Header="À _propos…" Command="{Binding ShowAboutCommand}" />
      </MenuItem>
    </Menu>

    <!-- Restitution toujours accessible : blackout (GEN-082, touche B) et Grand Master (CMD-002) -->
    <Border DockPanel.Dock="Top" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="12,6">
      <StackPanel Orientation="Horizontal" Spacing="12" HorizontalAlignment="Right">
        <TextBlock Text="Grand Master" VerticalAlignment="Center" Opacity="0.8" />
        <Slider Minimum="0" Maximum="100" Value="{Binding GrandMaster}" Width="200" VerticalAlignment="Center" />
        <TextBlock Text="{Binding GrandMaster, StringFormat='{}{0:0} %'}" Width="48" VerticalAlignment="Center" />
        <ToggleButton Classes="blackout" IsChecked="{Binding Blackout}" Content="BLACKOUT (B)" MinWidth="150"
                      ToolTip.Tip="Coupe toutes les intensités au tick suivant ; couleurs et positions inchangées (GEN-041). Touche B." />
      </StackPanel>
    </Border>

    <!-- Barre d'état permanente (GEN-104) -->
    <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10" Fill="{Binding OutputColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding OutputStatus}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FramesPerSecond}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
          <TextBlock Text="{Binding EngineIndicators}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectName}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding ProjectMessage}" Foreground="#D29922" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0" Width="170">
      <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" Margin="0,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItem">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Glyph}" Width="18" TextAlignment="Center" />
              <TextBlock Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Écran courant -->
    <ContentControl Content="{Binding SelectedPage.Page}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="console:ConsoleViewModel">
          <console:ConsoleView />
        </DataTemplate>
        <DataTemplate DataType="library:LibraryViewModel">
          <library:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="installation:InstallationViewModel">
          <installation:InstallationView />
        </DataTemplate>
        <DataTemplate DataType="simulator:SimulatorViewModel">
          <simulator:SimulatorView />
        </DataTemplate>
        <DataTemplate DataType="scenes:ScenesViewModel">
          <scenes:ScenesView />
        </DataTemplate>
        <DataTemplate DataType="outputs:OutputsViewModel">
          <outputs:OutputsView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
