<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="Luxia.App.App"
             RequestedThemeVariant="Dark">
  <!-- GEN-101 : thème sombre par défaut. -->
  <Application.Resources>
    <!-- BIB-097 : barre de défilement plus épaisse même repliée, plus facile à attraper à la souris. -->
    <x:Double x:Key="ScrollBarThumbThickness">8</x:Double>
    <x:Double x:Key="ScrollBarSize">16</x:Double>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- SORT-065 : voyant rouge qui clignote pendant un enregistrement de trames. -->
    <Style Selector="Ellipse.rec">
      <Setter Property="Fill" Value="#F85149" />
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#161B22" />
      <Setter Property="BorderBrush" Value="#30363D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
      <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <!-- Action destructrice (suppression) : la confirmation (GEN-103) reste la protection principale, ceci n'est qu'un repère visuel. -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#F85149" />
    </Style>
    <!-- GEN-082 : blackout bien visible ; rouge franc quand il est actif. -->
    <Style Selector="ToggleButton.blackout">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F85149" />
      <Setter Property="BorderBrush" Value="#F85149" />
    </Style>
    <Style Selector="ToggleButton.blackout:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#DA3633" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
