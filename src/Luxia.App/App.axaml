<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:dock="using:Dock.Avalonia.Themes.Fluent"
             x:Class="Luxia.App.App"
             RequestedThemeVariant="Dark">
  <!-- GEN-101 : thème sombre par défaut. -->
  <Application.Resources>
    <ResourceDictionary>
      <ResourceDictionary.MergedDictionaries>
        <!-- C11 : libellés des menus de Dock (panneaux ancrables) en français. -->
        <ResourceInclude Source="avares://Luxia.UI.Modules.Control/Views/DockStrings.fr.axaml" />
      </ResourceDictionary.MergedDictionaries>
    <!-- BIB-097 : barre de défilement plus épaisse même repliée, plus facile à attraper à la souris. -->
    <x:Double x:Key="ScrollBarThumbThickness">8</x:Double>
    <x:Double x:Key="ScrollBarSize">16</x:Double>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <FluentTheme />
    <!-- E4 : panneaux ancrables et détachables de l'écran Contrôle (bibliothèque Dock). -->
    <dock:DockFluentTheme />
    <!-- Essai P8 (ex. 15, lisibilité) : flèches des champs numériques plus étroites (≈ 24 px au lieu de ≈ 34), pour laisser
         la place au nombre ; chaque champ est en plus assez large pour sa plus longue valeur. La pseudo-classe jamais posée
         « :not(:luxia) » donne au style la priorité d'un déclencheur, au-dessus de la largeur minimale fixée par le modèle Fluent. -->
    <Style Selector="NumericUpDown /template/ ButtonSpinner /template/ RepeatButton:not(:luxia)">
      <Setter Property="MinWidth" Value="24" />
      <Setter Property="Width" Value="24" />
      <Setter Property="Padding" Value="0" />
    </Style>
    <!-- SORT-065 : voyant rouge qui clignote pendant un enregistrement de trames. -->
    <Style Selector="Ellipse.rec">
      <Setter Property="Fill" Value="#F85149" />
      <Style.Animations>
        <Animation Duration="0:0:1" IterationCount="Infinite">
          <KeyFrame Cue="0%"><Setter Property="Opacity" Value="1" /></KeyFrame>
          <KeyFrame Cue="50%"><Setter Property="Opacity" Value="0.15" /></KeyFrame>
          <KeyFrame Cue="100%"><Setter Property="Opacity" Value="1" /></KeyFrame>
        </Animation>
      </Style.Animations>
    </Style>
    <Style Selector="Border.panel">
      <Setter Property="Background" Value="#161B22" />
      <Setter Property="BorderBrush" Value="#30363D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Padding" Value="12" />
    </Style>
    <Style Selector="TextBlock.section">
      <Setter Property="FontSize" Value="16" />
      <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="StackPanel.field">
      <Setter Property="Spacing" Value="4" />
      <Setter Property="Margin" Value="0,0,16,8" />
    </Style>
    <!-- Action destructrice (suppression) : la confirmation (GEN-103) reste la protection principale, ceci n'est qu'un repère visuel. -->
    <Style Selector="Button.danger">
      <Setter Property="Foreground" Value="#F85149" />
    </Style>
    <!-- GEN-082 : blackout bien visible ; rouge franc quand il est actif. -->
    <Style Selector="ToggleButton.blackout">
      <Setter Property="FontWeight" Value="Bold" />
      <Setter Property="Foreground" Value="#F85149" />
      <Setter Property="BorderBrush" Value="#F85149" />
    </Style>
    <Style Selector="ToggleButton.blackout:checked /template/ ContentPresenter">
      <Setter Property="Background" Value="#DA3633" />
      <Setter Property="Foreground" Value="White" />
    </Style>
  </Application.Styles>
</Application>
