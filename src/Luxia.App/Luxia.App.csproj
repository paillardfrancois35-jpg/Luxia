<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <AssemblyName>LuXia</AssemblyName>
    <AvaloniaUseCompiledBindingsByDefault>true</AvaloniaUseCompiledBindingsByDefault>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\luxia.ico</ApplicationIcon>
  </PropertyGroup>

  <!--
    GEN-119 : numéro de compilation en développement. Le compteur vit hors du dépôt (build/, ignoré par Git) :
    chaque compilation de l'application l'augmente de 1 et l'inscrit dans la version affichée (barre de titre, À propos).
  -->
  <Target Name="LuxiaBuildNumber" BeforeTargets="GetAssemblyAttributes" Condition="'$(LuxiaDevVersion)' != ''">
    <PropertyGroup>
      <LuxiaBuildNumberFile>$(MSBuildThisFileDirectory)../../build/numero-de-compilation.txt</LuxiaBuildNumberFile>
    </PropertyGroup>
    <ReadLinesFromFile File="$(LuxiaBuildNumberFile)" Condition="Exists('$(LuxiaBuildNumberFile)')">
      <Output TaskParameter="Lines" PropertyName="LuxiaLastBuildNumber" />
    </ReadLinesFromFile>
    <PropertyGroup>
      <LuxiaLastBuildNumber Condition="'$(LuxiaLastBuildNumber)' == ''">0</LuxiaLastBuildNumber>
      <LuxiaBuildNumber>$([MSBuild]::Add($(LuxiaLastBuildNumber), 1))</LuxiaBuildNumber>
      <InformationalVersion>$(LuxiaDevVersion).$(LuxiaBuildNumber.PadLeft(3, '0'))</InformationalVersion>
    </PropertyGroup>
    <MakeDir Directories="$([System.IO.Path]::GetDirectoryName($(LuxiaBuildNumberFile)))" />
    <WriteLinesToFile File="$(LuxiaBuildNumberFile)" Lines="$(LuxiaBuildNumber)" Overwrite="true" />
    <Message Importance="high" Text="LuXia : version $(InformationalVersion)" />
  </Target>

  <ItemGroup>
    <AvaloniaResource Include="Assets\luxia.ico" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Avalonia" />
    <PackageReference Include="Avalonia.Desktop" />
    <PackageReference Include="Avalonia.Themes.Fluent" />
    <PackageReference Include="Avalonia.Fonts.Inter" />
    <PackageReference Include="CommunityToolkit.Mvvm" />
    <ProjectReference Include="../Luxia.Core/Luxia.Core.csproj" />
    <ProjectReference Include="../Luxia.Messaging/Luxia.Messaging.csproj" />
    <ProjectReference Include="../Luxia.Engine/Luxia.Engine.csproj" />
    <ProjectReference Include="../Luxia.Output/Luxia.Output.csproj" />
    <ProjectReference Include="../Luxia.Persistence/Luxia.Persistence.csproj" />
    <ProjectReference Include="../Luxia.Hosting/Luxia.Hosting.csproj" />
    <ProjectReference Include="../Luxia.UI.Controls/Luxia.UI.Controls.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Outputs/Luxia.UI.Modules.Outputs.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Console/Luxia.UI.Modules.Console.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Library/Luxia.UI.Modules.Library.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Installation/Luxia.UI.Modules.Installation.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Simulator/Luxia.UI.Modules.Simulator.csproj" />
    <ProjectReference Include="../Luxia.UI.Modules.Scenes/Luxia.UI.Modules.Scenes.csproj" />
  </ItemGroup>

</Project>
