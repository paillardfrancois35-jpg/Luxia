<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Live"
             x:Class="Luxia.UI.Modules.Live.LiveView"
             x:DataType="vm:LiveViewModel">
  <UserControl.Styles>
    <!-- Boutons « à maintenir » : bordures pressables (appui / relâche), gros et contrastés. -->
    <Style Selector="Border.pad">
      <Setter Property="CornerRadius" Value="6" />
      <Setter Property="Background" Value="#161B22" />
      <Setter Property="BorderBrush" Value="#30363D" />
      <Setter Property="BorderThickness" Value="1" />
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.pad:disabled">
      <Setter Property="Opacity" Value="0.35" />
    </Style>
    <Style Selector="Border.pad:pointerover">
      <Setter Property="BorderBrush" Value="#8B949E" />
    </Style>
    <Style Selector="Border.pill">
      <Setter Property="CornerRadius" Value="10" />
      <Setter Property="Padding" Value="10,3" />
      <Setter Property="Background" Value="#161B22" />
    </Style>
    <Style Selector="TextBlock.small">
      <Setter Property="FontSize" Value="11" />
      <Setter Property="Foreground" Value="#8B949E" />
    </Style>
  </UserControl.Styles>

  <UserControl.Resources>
    <DataTemplate x:Key="QuickPalette" x:DataType="vm:QuickPaletteViewModel">
      <Button FontSize="11" Padding="6,3" Margin="0,0,4,4" BorderBrush="{Binding Color}" BorderThickness="0,0,0,3"
              Command="{Binding $parent[UserControl].((vm:LiveViewModel)DataContext).ApplyPaletteCommand}" CommandParameter="{Binding}">
        <StackPanel Orientation="Horizontal" Spacing="4">
          <Border Width="10" Height="10" CornerRadius="5" Background="{Binding Color}" />
          <TextBlock Text="{Binding Name}" />
        </StackPanel>
      </Button>
    </DataTemplate>
  </UserControl.Resources>

  <Grid RowDefinitions="Auto,*,Auto" Margin="12,8,12,8">
    <!-- Bandeau d'état (LIVE-001, LIVE-008, LIVE-010) -->
    <WrapPanel Grid.Row="0" Margin="0,0,0,8">
      <Border Classes="pill" Margin="0,0,6,4" Background="{Binding OutputColor}">
        <TextBlock Text="{Binding OutputText}" FontWeight="SemiBold" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="#161B22"
              IsVisible="{Binding ControllersText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding ControllersText}" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="#1F6FEB" IsVisible="{Binding Frozen}">
        <TextBlock Text="❄ FIGÉ" FontWeight="Bold" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="#6E7681" IsVisible="{Binding Smoking}">
        <TextBlock Text="☁ FUMÉE" FontWeight="Bold" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="#161B22">
        <TextBlock Text="{Binding VenueText}" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="{Binding HasLimits, Converter={x:Static vm:LiveView.WarningBackground}}"
              ToolTip.Tip="{Binding LimitsDetail}">
        <TextBlock Text="{Binding LimitsText}" />
      </Border>
      <Border Classes="pill" Margin="0,0,6,4" Background="#3D2E00"
              IsVisible="{Binding CalibrationText, Converter={x:Static StringConverters.IsNotNullOrEmpty}}">
        <TextBlock Text="{Binding CalibrationText}" Foreground="#E3B341" />
      </Border>
      <TextBlock Text="Aucun projet ouvert : menu Projet → Ouvrir." IsVisible="{Binding !HasProject}" VerticalAlignment="Center" Margin="6,0" />
    </WrapPanel>

    <!-- Couches (LIVE-002) et actions permanentes (LIVE-004) -->
    <Grid Grid.Row="1" ColumnDefinitions="*,190">
      <ScrollViewer x:Name="ColumnsScroll" Grid.Column="0" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
        <ItemsControl x:Name="ColumnsList" ItemsSource="{Binding Columns}" HorizontalAlignment="Left">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:LayerColumnViewModel">
              <Border CornerRadius="6" Background="#0D1117" BorderThickness="1" Margin="0,0,6,0" MaxWidth="220"
                      BorderBrush="{Binding IsSelected, Converter={x:Static vm:LiveView.SelectedBorder}}">
                <DockPanel Margin="6">
                  <StackPanel DockPanel.Dock="Top" Spacing="2" Margin="0,0,0,6">
                    <Border Height="4" CornerRadius="2" Background="{Binding Color}" />
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                    <TextBlock Classes="small" Text="maintenir = flash" IsVisible="{Binding IsFlash}" />
                  </StackPanel>
                  <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                    <Button DockPanel.Dock="Left" Content="■" Width="32" Padding="0" HorizontalContentAlignment="Center"
                            ToolTip.Tip="Arrêter la couche"
                            Command="{Binding $parent[ItemsControl].((vm:LiveViewModel)DataContext).StopLayerCommand}" CommandParameter="{Binding}" />
                    <TextBlock DockPanel.Dock="Right" Classes="small" Width="32" TextAlignment="Right"
                               Text="{Binding Master, StringFormat={}{0:0} %}" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100" Value="{Binding Master}" Margin="4,0" ToolTip.Tip="Master de la couche" />
                  </DockPanel>
                  <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <ItemsControl ItemsSource="{Binding Scenes}">
                      <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LiveSceneViewModel">
                          <Border Classes="pad" Height="42" Margin="0,0,0,4" Tag="{Binding}"
                                  Background="{Binding Fill}" BorderBrush="{Binding Color}"
                                  BorderThickness="{Binding IsActive, Converter={x:Static vm:LiveView.ActiveThickness}}"
                                  PointerPressed="OnScenePressed" PointerReleased="OnSceneReleased" PointerCaptureLost="OnSceneCaptureLost"
                                  ToolTip.Tip="{Binding Name}">
                            <Grid RowDefinitions="*,Auto" Margin="5,1">
                              <DockPanel Grid.Row="0">
                                <TextBlock DockPanel.Dock="Left" Classes="small" Text="{Binding Marker}" Width="12" VerticalAlignment="Center" />
                                <TextBlock DockPanel.Dock="Right" Classes="small" Text="{Binding State}" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding Name}" TextWrapping="Wrap" MaxLines="2" TextTrimming="CharacterEllipsis"
                                           FontWeight="{Binding IsActive, Converter={x:Static vm:LiveView.ActiveWeight}}"
                                           VerticalAlignment="Center" FontSize="12" Margin="4,0" />
                              </DockPanel>
                              <ProgressBar Grid.Row="1" Height="3" MinHeight="3" Minimum="0" Maximum="1" Value="{Binding Progress}"
                                           Foreground="{Binding Color}" Background="Transparent" IsVisible="{Binding IsActive}" />
                            </Grid>
                          </Border>
                        </DataTemplate>
                      </ItemsControl.ItemTemplate>
                    </ItemsControl>
                  </ScrollViewer>
                </DockPanel>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>

      <StackPanel Grid.Column="1" Spacing="6" Margin="10,0,0,0">
        <Border Classes="pad" Height="54" Background="#2D333B" IsEnabled="{Binding HasFlash}"
                PointerPressed="OnFlashPressed" PointerReleased="OnFlashReleased" PointerCaptureLost="OnFlashLost"
                ToolTip.Tip="Maintenir : flash général (touche F). Scène : « Flash blanc » d'une couche Flash, ou flashSceneId de live.json">
          <TextBlock Text="FLASH  (F)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Border Classes="pad" Height="54" Background="#2D333B" IsEnabled="{Binding HasStrobe}"
                PointerPressed="OnStrobePressed" PointerReleased="OnStrobeReleased" PointerCaptureLost="OnStrobeLost"
                ToolTip.Tip="Maintenir : strobe général (touche S), borné par la sûreté. Scène : « Strobe… » d'une couche Flash, ou strobeSceneId de live.json">
          <TextBlock Text="STROBE  (S)" FontWeight="Bold" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
        </Border>
        <Grid ColumnDefinitions="*,6,70">
          <Border Grid.Column="0" Classes="pad" Height="54" Background="#2D333B"
                  PointerPressed="OnSmokePressed" PointerReleased="OnSmokeReleased" PointerCaptureLost="OnSmokeLost"
                  ToolTip.Tip="Maintenir : fumée (touche Z), bornée par la sûreté">
            <TextBlock Text="FUMÉE (Z)" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center" />
          </Border>
          <Button Grid.Column="2" Content="Rafale" Height="54" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center"
                  VerticalContentAlignment="Center" Command="{Binding SmokeBurstCommand}" ToolTip.Tip="Rafale de fumée (durée : live.json)" />
        </Grid>
        <ToggleButton IsChecked="{Binding Frozen, Mode=OneWay}" Command="{Binding ToggleFreezeCommand}" Height="44"
                      HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                      Content="❄ FIGER  (G)" FontWeight="SemiBold" />
        <Button Content="■ Tout arrêter" Command="{Binding StopAllCommand}" Height="40" HorizontalAlignment="Stretch"
                HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                ToolTip.Tip="Arrête toutes les couches sauf les couches protégées (Ambiance)" />
        <TextBlock Classes="small" TextWrapping="Wrap" Margin="0,6,0,0"
                   Text="B blackout · F flash · S strobe · Z fumée · G figer · Échap libérer · 1-9 scène de la couche encadrée · ← → couche · Page ↑↓ Grand Master" />
      </StackPanel>
    </Grid>

    <!-- Palettes rapides (LIVE-005) et journal (LIVE-009, GEN-112) -->
    <Grid Grid.Row="2" ColumnDefinitions="*,340" Margin="0,8,0,0" MaxHeight="170">
      <Border Grid.Column="0" Classes="panel" Margin="0,0,8,0" Padding="8">
        <ScrollViewer VerticalScrollBarVisibility="Auto">
          <StackPanel Spacing="4">
            <DockPanel>
              <Button DockPanel.Dock="Right" Content="Libérer (Échap)" Command="{Binding ReleaseQuickCommand}" IsEnabled="{Binding HasQuickOverrides}" />
              <TextBlock Text="{Binding Message}" Foreground="#58A6FF" DockPanel.Dock="Right" Margin="8,0" VerticalAlignment="Center" />
              <ItemsControl ItemsSource="{Binding QuickSelections}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="vm:QuickSelectionViewModel">
                    <ToggleButton Content="{Binding Label}" IsChecked="{Binding IsSelected, Mode=OneWay}" FontSize="11" Padding="6,2" Margin="0,0,4,4"
                                  Command="{Binding $parent[ItemsControl].((vm:LiveViewModel)DataContext).SelectQuickCommand}" CommandParameter="{Binding}" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </DockPanel>
            <ItemsControl ItemsSource="{Binding Colors}" ItemTemplate="{StaticResource QuickPalette}">
              <ItemsControl.ItemsPanel>
                <ItemsPanelTemplate>
                  <WrapPanel />
                </ItemsPanelTemplate>
              </ItemsControl.ItemsPanel>
            </ItemsControl>
            <StackPanel Orientation="Horizontal" Spacing="12">
              <ItemsControl ItemsSource="{Binding Positions}" ItemTemplate="{StaticResource QuickPalette}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Intensities}" ItemTemplate="{StaticResource QuickPalette}">
                <ItemsControl.ItemsPanel>
                  <ItemsPanelTemplate>
                    <WrapPanel />
                  </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
              </ItemsControl>
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Border>
      <Border Grid.Column="1" Classes="panel" Padding="8">
        <DockPanel>
          <DockPanel DockPanel.Dock="Top">
            <CheckBox DockPanel.Dock="Right" Content="Commandes" IsChecked="{Binding ShowCommands}" FontSize="11" />
            <TextBlock Text="Journal" FontWeight="SemiBold" VerticalAlignment="Center" />
          </DockPanel>
          <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,4,0,0">
            <Panel>
              <ItemsControl ItemsSource="{Binding Journal}" IsVisible="{Binding !ShowCommands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <ItemsControl ItemsSource="{Binding Commands}" IsVisible="{Binding ShowCommands}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="x:String">
                    <TextBlock Text="{Binding}" FontSize="11" TextWrapping="Wrap" Margin="0,0,0,2" />
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
            </Panel>
          </ScrollViewer>
        </DockPanel>
      </Border>
    </Grid>
  </Grid>

</UserControl>
