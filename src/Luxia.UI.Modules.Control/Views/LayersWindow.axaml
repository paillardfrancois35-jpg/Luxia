<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Luxia.UI.Modules.Control"
        x:Class="Luxia.UI.Modules.Control.Views.LayersWindow"
        x:DataType="vm:LayersEditorViewModel"
        Title="Couches"
        Width="1280" Height="560"
        WindowStartupLocation="CenterOwner"
        Background="#0D1117">
  <DockPanel Margin="14">
    <StackPanel DockPanel.Dock="Top" Spacing="4" Margin="0,0,0,10">
      <TextBlock Classes="section" Text="Couches" />
      <TextBlock FontSize="12" Foreground="#8B949E" TextWrapping="Wrap"
                 Text="L'ordre de la liste donne les priorités : la couche du bas l'emporte sur celles du dessus (hors intensité, fusionnée en HTP par défaut). Une scène appartient à une couche ; on la change de couche dans l'éditeur de la scène." />
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Spacing="6" Margin="0,10,0,0">
      <Button Content="Nouvelle couche…" Command="{Binding AddCommand}" />
      <Button Content="▲ Monter" Command="{Binding MoveUpCommand}" />
      <Button Content="▼ Descendre" Command="{Binding MoveDownCommand}" />
      <Button Content="Supprimer…" Classes="danger" Command="{Binding DeleteCommand}" />
      <TextBlock Text="{Binding Message}" Foreground="#F85149" VerticalAlignment="Center" Margin="8,0" />
      <Border Width="40" />
      <Button Content="Enregistrer" Command="{Binding SaveCommand}" FontWeight="SemiBold" />
      <Button Content="Annuler" Command="{Binding CancelCommand}" />
    </StackPanel>

    <!-- En-têtes de colonnes -->
    <Grid DockPanel.Dock="Top" ColumnDefinitions="36,190,90,150,170,90,80,100,190,*" Margin="8,0,8,4">
      <Grid.Styles>
        <Style Selector="TextBlock">
          <Setter Property="FontSize" Value="11" />
          <Setter Property="Foreground" Value="#8B949E" />
        </Style>
      </Grid.Styles>
      <TextBlock Grid.Column="1" Text="Nom" />
      <TextBlock Grid.Column="2" Text="Exclusive" />
      <TextBlock Grid.Column="3" Text="Type" />
      <TextBlock Grid.Column="4" Text="Intensité" />
      <TextBlock Grid.Column="5" Text="Fondu (s)" />
      <TextBlock Grid.Column="6" Text="Master %" />
      <TextBlock Grid.Column="7" Text="Protégée" ToolTip.Tip="Épargnée par « Tout arrêter » (COU-007)" />
      <TextBlock Grid.Column="8" Text="Scène de repos" />
    </Grid>

    <ListBox ItemsSource="{Binding Layers}" SelectedItem="{Binding Selected}" Background="Transparent">
      <ListBox.ItemTemplate>
        <DataTemplate x:DataType="vm:LayerRowViewModel">
          <Grid ColumnDefinitions="36,190,90,150,170,90,80,100,190,*">
            <Border Grid.Column="0" Width="14" Height="14" CornerRadius="7" Background="{Binding Color}" HorizontalAlignment="Left" />
            <TextBox Grid.Column="1" Text="{Binding Name}" Width="176" HorizontalAlignment="Left" />
            <CheckBox Grid.Column="2" IsChecked="{Binding Exclusive}" ToolTip.Tip="Lancer une scène coupe celle qui jouait (fondu croisé)" />
            <ComboBox Grid.Column="3" ItemsSource="{x:Static vm:LayerRowViewModel.KindOptions}" SelectedItem="{Binding Kind}" Width="140" />
            <ComboBox Grid.Column="4" ItemsSource="{x:Static vm:LayerRowViewModel.IntensityOptions}" SelectedItem="{Binding Intensity}" Width="160" />
            <NumericUpDown Grid.Column="5" Value="{Binding CrossFadeSeconds}" Minimum="0" Maximum="600" Increment="0.1" FormatString="0.0#" Width="84" ShowButtonSpinner="False" />
            <NumericUpDown Grid.Column="6" Value="{Binding MasterPercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="74" ShowButtonSpinner="False" />
            <CheckBox Grid.Column="7" IsChecked="{Binding KeepOnStopAll}" />
            <ComboBox Grid.Column="8" ItemsSource="{Binding RestChoices}" SelectedItem="{Binding RestScene}" Width="180" />
            <TextBlock Grid.Column="9" Text="{Binding ScenesLabel}" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
          </Grid>
        </DataTemplate>
      </ListBox.ItemTemplate>
    </ListBox>
  </DockPanel>
</Window>
