<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Control"
             xmlns:sq="using:Luxia.UI.Modules.Control.Sequencing"
             x:Class="Luxia.UI.Modules.Control.Views.ColumnsPanelView"
             x:DataType="vm:ColumnsPanelViewModel">
  <UserControl.Styles>
    <Style Selector="Button.mini">
      <Setter Property="Padding" Value="0" />
      <Setter Property="Width" Value="34" />
      <Setter Property="Height" Value="32" />
      <Setter Property="FontSize" Value="12" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- Bande ✎ : le survol garde sa couleur (verte en ÉDITION) et s'éclaircit, au lieu du gris du thème (essai 1.005.198). -->
    <Style Selector="Button.editband:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="{TemplateBinding Background}" />
    </Style>
    <Style Selector="Button.editband:pointerover">
      <Setter Property="Opacity" Value="0.75" />
    </Style>
    <!-- Valeurs normales en styles (une valeur posée sur l'élément l'emporterait sur le mode resserré). -->
    <Style Selector="Border.play">
      <Setter Property="MinHeight" Value="48" />
      <Setter Property="Padding" Value="8,6,6,4" />
    </Style>
    <Style Selector="TextBlock.name">
      <Setter Property="TextWrapping" Value="Wrap" />
      <Setter Property="MaxLines" Value="2" />
    </Style>
    <!-- Mode resserré (essai 1.005.226) : une ligne, environ moitié moins haut ; texte d'état masqué (la fine barre d'avancement reste). -->
    <Style Selector="DockPanel.compact Border.play">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3,6,3" />
    </Style>
    <Style Selector="DockPanel.compact TextBlock.state">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.compact Border.play">
      <Setter Property="MinHeight" Value="26" />
      <Setter Property="Padding" Value="8,3,6,3" />
    </Style>
    <Style Selector="ItemsControl.compact TextBlock.name">
      <Setter Property="MaxLines" Value="1" />
      <Setter Property="TextWrapping" Value="NoWrap" />
    </Style>
    <Style Selector="ItemsControl.compact TextBlock.state">
      <Setter Property="IsVisible" Value="False" />
    </Style>
    <Style Selector="ItemsControl.compact StackPanel.scenes">
      <Setter Property="Spacing" Value="3" />
    </Style>
    <Style Selector="Border.play">
      <Setter Property="Cursor" Value="Hand" />
    </Style>
    <Style Selector="Border.play:pointerover">
      <Setter Property="Opacity" Value="0.85" />
    </Style>
  </UserControl.Styles>

  <!-- Les colonnes se partagent la largeur (une par fader de l'APC), sans descendre sous 120 px : défilement au-delà. -->
  <!-- La ligne du « ? » porte le choix d'affichage (marges : plus de ligne réservée au seul « ? »). -->
  <DockPanel Margin="6,4,6,6">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,30,4" Height="24">
      <ToggleButton Content="☰ Resserré" IsChecked="{Binding IsCompact}" Padding="8,0" FontSize="12" VerticalContentAlignment="Center"
                    ToolTip.Tip="Boutons de scène sur une ligne, environ moitié moins hauts (nom complet en infobulle) ; gardé sur ce poste" />
    </StackPanel>
  <!-- ERG-030 (essai P6) : les en-têtes de couche restent en haut, chaque colonne fait défiler ses scènes ; le défilement
       horizontal (colonnes trop nombreuses) déplace en-têtes et scènes ensemble. -->
  <ScrollViewer x:Name="Scroll" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
    <DockPanel x:Name="Board" Classes.compact="{Binding IsCompact}" HorizontalAlignment="Left" MinWidth="{Binding MinWidth}">
      <!-- Colonne « Shows » (P8, Q44 solution C, maquette 9) : shows puis séquences, mêmes gestes que les scènes. -->
      <Border DockPanel.Dock="Left" Width="{x:Static vm:ColumnsPanelViewModel.ShowsWidth}" Background="#161B22" CornerRadius="8" Padding="6" Margin="0,0,6,0"
              DataContext="{Binding Shows}" x:DataType="sq:ShowsColumnViewModel">
        <DockPanel>
          <Border DockPanel.Dock="Top" BorderBrush="#39C5CF" BorderThickness="0,3,0,0" Padding="2,6,2,6"
                  ToolTip.Tip="Shows : enchaînements d'étapes qui réagissent à la musique (un seul show principal à la fois). Séquences : scènes posées sur des pistes, en mesures.">
            <StackPanel Spacing="2">
              <TextBlock Text="▶  Shows" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" />
              <TextBlock Text="un show à la fois : le nouveau remplace l'ancien" FontSize="10" Foreground="#8B949E" TextWrapping="Wrap" TextAlignment="Center" />
            </StackPanel>
          </Border>
          <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
            <StackPanel Spacing="5">
              <TextBlock Text="SHOWS" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" />
              <ItemsControl ItemsSource="{Binding Shows}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Classes="scenes" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sq:ShowItemViewModel">
                    <Border CornerRadius="7" BorderBrush="#3FB950" BorderThickness="{Binding OutlineThickness}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Width="30" Classes="editband" Content="✎" Padding="0" CornerRadius="0,6,6,0" Background="{Binding EditBandFill}"
                                IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Ouvrir la fenêtre d'édition"
                                Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).Shows.EditCommand}" CommandParameter="{Binding}" />
                        <Border Classes="play" Background="{Binding Fill}" BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" CornerRadius="6,0,0,6"
                                PointerPressed="OnShowPressed" ContextRequested="OnShowContext" ToolTip.ShowDelay="600">
                          <ToolTip.Tip>
                            <StackPanel Spacing="3" MaxWidth="320">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap" />
                              <TextBlock Text="Clic : lancer / arrêter · ✎ : éditer · clic droit : menu" FontSize="11" Foreground="#8B949E" />
                            </StackPanel>
                          </ToolTip.Tip>
                          <DockPanel>
                            <ProgressBar DockPanel.Dock="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3"
                                         Foreground="{Binding TextColor}" Background="Transparent" Opacity="0.45" IsVisible="{Binding ShowsProgress}" />
                            <TextBlock Classes="state" DockPanel.Dock="Bottom" Text="{Binding State}" FontSize="11" Foreground="{Binding TextColor}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="name" Text="{Binding Name}" FontSize="13" Foreground="{Binding TextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ show" MinHeight="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="#8B949E"
                      IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}"
                      ToolTip.Tip="Nouveau show, ouvert aussitôt dans sa fenêtre d'édition" Command="{Binding NewShowCommand}" />
              <TextBlock Text="SÉQUENCES" FontSize="10" FontWeight="SemiBold" Foreground="#8B949E" Margin="0,8,0,0" />
              <ItemsControl ItemsSource="{Binding Sequences}">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Classes="scenes" Spacing="5" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sq:ShowItemViewModel">
                    <Border CornerRadius="7" BorderBrush="#3FB950" BorderThickness="{Binding OutlineThickness}">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Width="30" Classes="editband" Content="✎" Padding="0" CornerRadius="0,6,6,0" Background="{Binding EditBandFill}"
                                IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                ToolTip.Tip="Ouvrir la fenêtre d'édition"
                                Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).Shows.EditCommand}" CommandParameter="{Binding}" />
                        <Border Classes="play" Background="{Binding Fill}" BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" CornerRadius="6,0,0,6"
                                PointerPressed="OnShowPressed" ContextRequested="OnShowContext" ToolTip.ShowDelay="600">
                          <ToolTip.Tip>
                            <StackPanel Spacing="3" MaxWidth="320">
                              <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                              <TextBlock Text="{Binding State}" FontSize="12" TextWrapping="Wrap" />
                              <TextBlock Text="Clic : lancer / arrêter · ✎ : éditer · clic droit : menu" FontSize="11" Foreground="#8B949E" />
                            </StackPanel>
                          </ToolTip.Tip>
                          <DockPanel>
                            <ProgressBar DockPanel.Dock="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3"
                                         Foreground="{Binding TextColor}" Background="Transparent" Opacity="0.45" IsVisible="{Binding ShowsProgress}" />
                            <TextBlock Classes="state" DockPanel.Dock="Bottom" Text="{Binding State}" FontSize="11" Foreground="{Binding TextColor}" Opacity="0.8" TextTrimming="CharacterEllipsis" />
                            <TextBlock Classes="name" Text="{Binding Name}" FontSize="13" Foreground="{Binding TextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                          </DockPanel>
                        </Border>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <Button Content="+ séquence" MinHeight="32" HorizontalAlignment="Stretch" HorizontalContentAlignment="Center" Foreground="#8B949E"
                      IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}"
                      ToolTip.Tip="Nouvelle séquence de 8 mesures, ouverte aussitôt dans sa fenêtre d'édition" Command="{Binding NewSequenceCommand}" />
            </StackPanel>
          </ScrollViewer>
        </DockPanel>
      </Border>
      <ItemsControl DockPanel.Dock="Top" ItemsSource="{Binding Columns}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <UniformGrid Rows="1" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:ControlColumnViewModel">
            <Border Background="#161B22" CornerRadius="8,8,0,0" Padding="6,6,6,0" Margin="0,0,6,0">
                <!-- En-tête de couche : nom, étape précédente / suivante, arrêt, master (doc 60 §5) -->
                <Border BorderBrush="{Binding Color}" BorderThickness="0,3,0,0" Padding="2,6,2,2" ToolTip.Tip="{Binding Help}">
                  <StackPanel Spacing="6">
                    <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="14" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
                    <StackPanel Orientation="Horizontal" Spacing="4" HorizontalAlignment="Center">
                      <Button Classes="mini" Content="◀" IsEnabled="{Binding CanStep}" ToolTip.ShowOnDisabled="True"
                              ToolTip.Tip="Étape précédente de la scène qui joue (seulement pour une scène à plusieurs étapes)"
                              Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).PreviousStepCommand}" CommandParameter="{Binding}" />
                      <Button Classes="mini" Content="▶" IsEnabled="{Binding CanStep}" ToolTip.ShowOnDisabled="True"
                              ToolTip.Tip="Étape suivante de la scène qui joue (seulement pour une scène à plusieurs étapes)"
                              Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).NextStepCommand}" CommandParameter="{Binding}" />
                      <Button Classes="mini" Content="■" Foreground="#F85149" ToolTip.Tip="Arrêter la couche : net, sauf si la scène qui joue porte un fondu de sortie"
                              Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).StopLayerCommand}" CommandParameter="{Binding}" />
                    </StackPanel>
                    <Grid ColumnDefinitions="Auto,*,40" ToolTip.Tip="Niveau de la couche : multiplie les intensités qu'elle envoie (faders 1 à 8 de l'APC). Sans effet sur une couleur seule, ni si une autre couche envoie plus fort (la plus forte intensité l'emporte)">
                      <TextBlock Text="Niveau" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" Margin="0,0,4,0" />
                      <Slider Grid.Column="1" Minimum="0" Maximum="100" Value="{Binding Master}" VerticalAlignment="Center" Margin="0,-8" />
                      <TextBlock Grid.Column="2" Text="{Binding Master, StringFormat='{}{0:0} %'}" FontSize="11" VerticalAlignment="Center" TextAlignment="Right" />
                    </Grid>
                  </StackPanel>
                </Border>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
      <!-- Un ascenseur par colonne (idée de l'utilisateur, essai P6) : chaque couche fait défiler ses propres scènes. -->
        <ItemsControl x:Name="ColumnsList" ItemsSource="{Binding Columns}" Classes.compact="{Binding IsCompact}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <UniformGrid Rows="1" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ControlColumnViewModel">
              <Border Background="#161B22" CornerRadius="0,0,8,8" Padding="6,6,2,6" Margin="0,0,6,0">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0"
                              AttachedToVisualTree="OnColumnAttached" ScrollChanged="OnColumnScrolled">
                <StackPanel Spacing="6">
                  <!-- Boutons de scène à deux zones -->
                  <ItemsControl ItemsSource="{Binding Scenes}">
                    <ItemsControl.ItemsPanel>
                      <ItemsPanelTemplate>
                        <StackPanel Classes="scenes" Spacing="6" />
                      </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                      <DataTemplate x:DataType="vm:ControlSceneViewModel">
                        <Border CornerRadius="7" BorderBrush="{Binding EditColor}" BorderThickness="{Binding OutlineThickness}"
                                Opacity="{Binding HiddenInLive, Converter={x:Static vm:ControlConverters.DimIfTrue}}">
                          <DockPanel>
                            <Button DockPanel.Dock="Right" Width="34" IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}" Classes="editband" Content="✎" Padding="0" CornerRadius="0,6,6,0" Background="{Binding EditBandFill}"
                                    HorizontalAlignment="Stretch" VerticalAlignment="Stretch" HorizontalContentAlignment="Center" VerticalContentAlignment="Center"
                                    ToolTip.Tip="Ouvrir la fenêtre d'édition de cette scène"
                                    Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).ChooseForEditCommand}" CommandParameter="{Binding}" />
                            <Border Classes="play" Background="{Binding Fill}" BorderBrush="{Binding Color}" BorderThickness="4,0,0,0"
                                    CornerRadius="6,0,0,6"
                                    PointerPressed="OnScenePressed" PointerReleased="OnSceneReleased" PointerCaptureLost="OnSceneCaptureLost" ContextRequested="OnSceneContext"
                                    ToolTip.ShowDelay="600">
                              <ToolTip.Tip>
                                <StackPanel Spacing="3" MaxWidth="320">
                                  <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                                  <TextBlock Text="{Binding State}" IsVisible="{Binding IsActive}" FontSize="12" />
                                  <TextBlock Text="Clic : lancer / arrêter (maintenir : flash) · ✎ : éditer · clic droit : menu" FontSize="11" Foreground="#8B949E" />
                                </StackPanel>
                              </ToolTip.Tip>
                              <DockPanel>
                                <ProgressBar DockPanel.Dock="Bottom" Minimum="0" Maximum="1" Value="{Binding Progress}" Height="3" MinHeight="3"
                                             Foreground="{Binding TextColor}" Background="Transparent" Opacity="0.45" IsVisible="{Binding ShowsProgress}"
                                             ToolTip.Tip="Avancement de l'étape en cours" />
                                <TextBlock Classes="state" DockPanel.Dock="Bottom" Text="{Binding State}" FontSize="11" Foreground="{Binding TextColor}" Opacity="0.8" />
                                <TextBlock Classes="name" Text="{Binding Name}" FontSize="13" Foreground="{Binding TextColor}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" />
                              </DockPanel>
                            </Border>

                          </DockPanel>
                        </Border>
                      </DataTemplate>
                    </ItemsControl.ItemTemplate>
                  </ItemsControl>

                  <Button Content="+ scène" MinHeight="36" HorizontalAlignment="Stretch" IsVisible="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).CanEdit}" HorizontalContentAlignment="Center" Foreground="#8B949E"
                          ToolTip.Tip="Nouvelle scène dans cette couche"
                          Command="{Binding $parent[UserControl].((vm:ColumnsPanelViewModel)DataContext).NewSceneCommand}" CommandParameter="{Binding}" />
                </StackPanel>
                </ScrollViewer>
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
    </DockPanel>
  </ScrollViewer>
  </DockPanel>
</UserControl>
