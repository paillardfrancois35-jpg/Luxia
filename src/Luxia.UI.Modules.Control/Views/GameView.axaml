<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Control"
             xmlns:sq="using:Luxia.UI.Modules.Control.Sequencing"
             xmlns:dockc="using:Dock.Avalonia.Controls"
             x:Class="Luxia.UI.Modules.Control.Views.GameView"
             x:DataType="vm:GameViewModel"
             Focusable="True">
  <UserControl.Styles>
    <!-- Verrou soirée : bleu quand il est posé. Un simple bouton (et non une bascule) : un refus ne peut plus le laisser coché. -->
    <Style Selector="Button.lock.locked">
      <Setter Property="Background" Value="#1F6FEB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.lock.locked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#388BFD" />
    </Style>
    <!-- Interrupteur Audio : bleu quand l'horloge suit la musique ; TAP s'allume un instant à chaque frappe (bouton ou touche T). -->
    <Style Selector="ToggleButton:checked /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#1F6FEB" />
      <Setter Property="TextElement.Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.tap.flash /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#3FB950" />
      <Setter Property="TextElement.Foreground" Value="#0D1117" />
    </Style>
    <!-- Essai P8 : tempo entendu ≠ tempo courant (×2, ÷ 2, ± 1) : bouton orange, un clic y revient. -->
    <Style Selector="Button.differs /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#9A4D0A" />
      <Setter Property="BorderBrush" Value="#F0883E" />
    </Style>
    <!-- Cibles d'au moins 32 px de haut (ERG-035). -->
    <Style Selector="Button.target">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- En-tête de l'écran de jeu : arrêter, verrouiller, annuler, panneaux. Aucun mode à garder en tête (ERG-032). -->
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="target" Content="↶" FontSize="16" ToolTip.Tip="{Binding UndoText}" Command="{Binding UndoCommand}" />
          <Button Classes="target" Content="↷" FontSize="16" ToolTip.Tip="{Binding RedoText}" Command="{Binding RedoCommand}" />
          <!-- Lot 7 de P8 : l'éditeur de couches, seul outil de l'ancien écran Scènes absent du Contrôle (COU-001). -->
          <Button x:Name="LayersButton" Classes="target" Content="Couches…" Margin="10,0,0,0" IsEnabled="{Binding HasProject}"
                  ToolTip.Tip="Créer, renommer, réordonner les couches (l'ordre donne les priorités), couche protégée de « Stop », fondu croisé, master" />
          <Button x:Name="PanelsButton" Classes="target" Content="Panneaux ▾" Margin="10,0,0,0" ToolTip.Tip="Réafficher un panneau fermé, ou le mettre au premier plan" />
          <Button x:Name="ResetLayoutButton" Classes="target" Content="Rétablir la disposition" ToolTip.Tip="Oublier la disposition enregistrée et revenir à celle livrée" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="target" Content="■ Stop" Foreground="#F85149"
                  Command="{Binding StopAllCommand}" CommandParameter="sauf-protegees"
                  ToolTip.Tip="Arrêter toutes les scènes, sauf les couches protégées (Ambiance par défaut : fumée, UV…). Réglage : bouton « Couches… » en haut à droite, colonne « Protégée »." />
          <Button Classes="target" Content="■ Tout stopper" Foreground="#F85149" Margin="0,0,10,0"
                  Command="{Binding StopAllCommand}" CommandParameter="tout"
                  ToolTip.Tip="Arrêter absolument toutes les scènes, couches protégées comprises (fin de soirée)" />
          <Button Classes="target lock" Classes.locked="{Binding IsLocked}" Content="🔒 Verrou soirée" Command="{Binding ToggleLockCommand}" Margin="0,0,10,0"
                        ToolTip.Tip="Verrou soirée : on ne fait plus que jouer et retoucher en direct ; l'ouverture de la fenêtre d'édition et la modification des scènes sont bloquées (anti-fausse manipulation). Bleu : verrou posé." />
          <TextBlock Text="{Binding Message}" Foreground="#D29922" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="700" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bloc BPM (Q42, essai P7 décision 1) : interrupteur Audio (gris = tempo à la main, bleu = suit la musique), BPM saisissable
         (Entrée), TAP (touche T), − +, corrections ×2 ÷ 2 « 1 ici » (toujours actives), voyants des temps. Largeurs fixes : rien ne bouge. -->
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,4">
      <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding Tempo}" x:DataType="vm:TempoBarViewModel" VerticalAlignment="Center">
        <TextBlock Text="♪" FontSize="16" VerticalAlignment="Center" />
        <ToggleButton Classes="target" Content="🎧 Audio" IsChecked="{Binding AudioOn}" IsEnabled="{Binding CanListen}" Width="96"
                      HorizontalContentAlignment="Center" ToolTip.Tip="{Binding AudioStatus}" />
        <TextBlock Text="{Binding ConfidenceText}" Foreground="{Binding ConfidenceColor}" Width="44" FontSize="12" VerticalAlignment="Center"
                   ToolTip.Tip="Confiance dans le tempo détecté (vert : sûr, orange : moyen, rouge : incertain, l'horloge garde alors son tempo)" />
        <!-- Essai P8 : tempo entendu par l'écoute (0 sans écoute), à gauche du tempo courant ; orange quand ils diffèrent (×2, ÷ 2,
             ± 1) ; un clic ramène le tempo courant au tempo entendu. -->
        <Button Classes="target" Classes.differs="{Binding HeardDiffers}" Width="70" Padding="0" HorizontalContentAlignment="Center"
                Command="{Binding FollowHeardCommand}" IsEnabled="{Binding CanFollowHeard}"
                ToolTip.Tip="Tempo entendu dans la musique (0 sans écoute). Orange : le tempo courant en diffère (×2, ÷ 2, + ou −) ; cliquer pour revenir au tempo de la musique">
          <StackPanel Spacing="0">
            <TextBlock Text="{Binding HeardText}" FontSize="14" FontWeight="SemiBold" HorizontalAlignment="Center" />
            <TextBlock Text="entendu" FontSize="9" Foreground="#8B949E" HorizontalAlignment="Center" />
          </StackPanel>
        </Button>
        <TextBlock Text="→" Foreground="#8B949E" VerticalAlignment="Center" />
        <TextBox x:Name="BpmBox" Text="{Binding BpmInput}" Width="64" MinHeight="34" FontSize="16" FontWeight="SemiBold" HorizontalContentAlignment="Right"
                 VerticalContentAlignment="Center" IsEnabled="{Binding ManualEnabled}" ToolTip.Tip="Tempo en battements par minute : taper une valeur puis Entrée">
          <TextBox.KeyBindings>
            <KeyBinding Gesture="Enter" Command="{Binding ApplyTypedBpmCommand}" />
          </TextBox.KeyBindings>
        </TextBox>
        <TextBlock Text="BPM" Foreground="#8B949E" VerticalAlignment="Center" />
        <Button Classes="target" Content="−" Width="38" Padding="0" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding DecreaseCommand}" IsEnabled="{Binding ManualEnabled}" ToolTip.Tip="Retirer 1 BPM" />
        <Button Classes="target" Content="+" Width="38" Padding="0" FontSize="18" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding IncreaseCommand}" IsEnabled="{Binding ManualEnabled}" ToolTip.Tip="Ajouter 1 BPM" />
        <Button Classes="target tap" Classes.flash="{Binding TapFlash}" Content="TAP" FontWeight="Bold" Width="56" HorizontalContentAlignment="Center" Command="{Binding TapCommand}" IsEnabled="{Binding ManualEnabled}"
                ToolTip.Tip="Taper le rythme : quatre frappes régulières donnent le tempo, chaque frappe cale le temps (touche T)" />
        <Button Classes="target" Content="×2" Width="44" Padding="0" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding TimesTwoCommand}" ToolTip.Tip="Doubler le tempo (corrige une détection à la moitié)" />
        <Button Classes="target" Content="÷ 2" Width="44" Padding="0" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" VerticalContentAlignment="Center" Command="{Binding DivideByTwoCommand}" ToolTip.Tip="Diviser le tempo par deux" />
        <Button Classes="target" Content="1 ici" Padding="8,4" Command="{Binding ResyncBarCommand}" ToolTip.Tip="Le temps en cours devient le premier de la mesure" />
        <TextBlock Text="●" Foreground="{Binding Beat1}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat2}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat3}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat4}" FontSize="16" VerticalAlignment="Center" />
      </StackPanel>
    </Border>

    <!-- Bandeau « Show en cours » (P8, Q44 solution C, maquettes 9 et 10) : visible seulement quand un show ou une séquence joue. -->
    <StackPanel DockPanel.Dock="Top" DataContext="{Binding Band}" x:DataType="sq:ShowBandViewModel" IsVisible="{Binding IsVisible}">
      <Panel>
        <Border Background="{Binding Color}" Opacity="0.12" />
        <Border BorderBrush="{Binding Color}" BorderThickness="0,1,0,1" Padding="10,4" MinHeight="42">
          <DockPanel>
            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
              <Button x:Name="ForceButton" Classes="target" Content="⏭ Forcer ▾" IsVisible="{Binding HasShow}"
                      ToolTip.Tip="Franchir tout de suite une des transitions possibles (à sa frontière musicale)" />
              <Button Classes="target" Content="■ Arrêter" Foreground="#F85149" Command="{Binding StopCommand}"
                      ToolTip.Tip="Arrêter le show (ses scènes s'arrêtent avec leur fondu), ou les séquences en cours" />
              <Button Classes="target" Content="{Binding ExpandText}" Command="{Binding ToggleCommand}" IsVisible="{Binding HasShow}"
                      ToolTip.Tip="Étape active, transitions en attente avec leur compte à rebours, show en parallèle" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" ClipToBounds="True">
              <TextBlock Text="▶" Foreground="{Binding Color}" FontSize="15" VerticalAlignment="Center" />
              <TextBlock Text="{Binding Title}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center" />
              <Border Background="{Binding Color}" CornerRadius="10" Padding="8,1" IsVisible="{Binding HasShow}" VerticalAlignment="Center">
                <TextBlock Text="{Binding Steps}" Foreground="#0D1117" FontSize="12" />
              </Border>
              <TextBlock Text="{Binding Since}" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" />
              <TextBlock Text="· ensuite :" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" IsVisible="{Binding HasShow}" />
              <ItemsControl ItemsSource="{Binding Next}" VerticalAlignment="Center">
                <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" Spacing="6" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sq:BandTransition">
                    <Border BorderBrush="{Binding Dot}" BorderThickness="1" CornerRadius="10" Padding="8,1">
                      <TextBlock Text="{Binding Compact}" Foreground="{Binding Dot}" FontSize="12" />
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SequenceText}" Foreground="#8B949E" FontSize="12" VerticalAlignment="Center" />
            </StackPanel>
          </DockPanel>
        </Border>
      </Panel>
      <Border IsVisible="{Binding IsExpanded}" Background="#161B22" BorderBrush="{Binding Color}" BorderThickness="0,0,0,1" Padding="12,6">
        <StackPanel Spacing="6">
          <TextBlock Text="{Binding PathText, StringFormat='Parcours : {0}'}" FontSize="12" Foreground="#8B949E" />
          <Grid ColumnDefinitions="380,*">
            <ItemsControl ItemsSource="{Binding ActiveSteps}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="sq:BandStep">
                  <Border BorderBrush="#39C5CF" BorderThickness="2" CornerRadius="8" Padding="10,6" Margin="0,0,10,6" Background="#21262D">
                    <StackPanel Spacing="3">
                      <StackPanel Orientation="Horizontal" Spacing="6">
                        <TextBlock Text="Étape active" FontSize="11" Foreground="#8B949E" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding Id}" FontWeight="Bold" />
                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                      </StackPanel>
                      <TextBlock Text="{Binding Actions}" FontSize="12" TextWrapping="Wrap" />
                    </StackPanel>
                  </Border>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <StackPanel Grid.Column="1" Spacing="4">
              <TextBlock Text="Transitions qui partent de l'étape (la première vraie l'emporte)" FontSize="12" Foreground="#8B949E" />
              <ItemsControl ItemsSource="{Binding Transitions}">
                <ItemsControl.ItemTemplate>
                  <DataTemplate x:DataType="sq:BandTransition">
                    <Border Background="#21262D" CornerRadius="6" Padding="10,3" Margin="0,0,0,4">
                      <DockPanel>
                        <Button DockPanel.Dock="Right" Content="⏭ Forcer" MinHeight="28" Padding="10,0" FontSize="12"
                                Command="{Binding $parent[UserControl].((vm:GameViewModel)DataContext).Band.ForceCommand}" CommandParameter="{Binding}"
                                ToolTip.Tip="Franchir cette transition comme si sa condition était vraie (à sa frontière musicale)" />
                        <StackPanel Orientation="Horizontal" Spacing="8" VerticalAlignment="Center">
                          <TextBlock Text="●" Foreground="{Binding Dot}" />
                          <TextBlock Text="{Binding Condition}" FontWeight="SemiBold" />
                          <TextBlock Text="{Binding Target, StringFormat='→ {0}'}" Foreground="#39C5CF" />
                          <TextBlock Text="{Binding Quantize}" FontSize="12" Foreground="#8B949E" />
                          <TextBlock Text="{Binding State}" FontSize="12" Foreground="{Binding Dot}" />
                        </StackPanel>
                      </DockPanel>
                    </Border>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ItemsControl>
              <TextBlock Text="{Binding SecondaryText}" FontSize="12" Foreground="#8B949E" TextWrapping="Wrap" />
            </StackPanel>
          </Grid>
        </StackPanel>
      </Border>
    </StackPanel>

    <!-- Retouches en direct : le seul rappel d'état de l'écran de jeu. Sa place est réservée en permanence : qu'il apparaisse ou
         disparaisse, rien ne bouge (essai 1.007.080 : la mise en page sautait sous la souris et le fader tenu clignotait). -->
    <Panel DockPanel.Dock="Top" Height="32">
      <Border Background="#D29922" Opacity="0.16" IsVisible="{Binding HasRetouches}" />
      <Border BorderBrush="{Binding RetouchBorder}" BorderThickness="0,1,0,1" Padding="10,0">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Content="Libérer tout  (Échap)" MinHeight="26" Padding="10,0" FontSize="12"
                  BorderBrush="#D29922" BorderThickness="1" Foreground="#D29922" Background="Transparent"
                  IsVisible="{Binding HasRetouches}" Command="{Binding ReleaseAllCommand}" />
          <TextBlock Text="{Binding RetouchText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                     Foreground="{Binding RetouchForeground}" />
        </DockPanel>
      </Border>
    </Panel>

    <TextBlock DockPanel.Dock="Top" Text="Aucun projet ouvert : menu Projet → Ouvrir." IsVisible="{Binding !HasProject}" Margin="12,8" />
    <dockc:DockControl x:Name="DockHost" InitializeLayout="True" InitializeFactory="True" />
  </DockPanel>
</UserControl>
