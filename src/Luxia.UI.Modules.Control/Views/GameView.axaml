<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Control"
             xmlns:dockc="using:Dock.Avalonia.Controls"
             x:Class="Luxia.UI.Modules.Control.Views.GameView"
             x:DataType="vm:GameViewModel"
             Focusable="True">
  <UserControl.Styles>
    <!-- Verrou soirée : bleu quand il est posé. Un simple bouton (et non une bascule) : un refus ne peut plus le laisser coché. -->
    <Style Selector="Button.lock.locked">
      <Setter Property="Background" Value="#1F6FEB" />
      <Setter Property="Foreground" Value="#FFFFFF" />
    </Style>
    <Style Selector="Button.lock.locked:pointerover /template/ ContentPresenter#PART_ContentPresenter">
      <Setter Property="Background" Value="#388BFD" />
    </Style>
    <!-- Cibles d'au moins 32 px de haut (ERG-035). -->
    <Style Selector="Button.target">
      <Setter Property="MinHeight" Value="34" />
      <Setter Property="Padding" Value="12,4" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
  </UserControl.Styles>

  <DockPanel>
    <!-- En-tête de l'écran de jeu : arrêter, verrouiller, annuler, panneaux. Aucun mode à garder en tête (ERG-032). -->
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,6">
      <DockPanel>
        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Spacing="6">
          <Button Classes="target" Content="↶" FontSize="16" ToolTip.Tip="{Binding UndoText}" Command="{Binding UndoCommand}" />
          <Button Classes="target" Content="↷" FontSize="16" ToolTip.Tip="{Binding RedoText}" Command="{Binding RedoCommand}" />
          <Button x:Name="PanelsButton" Classes="target" Content="Panneaux ▾" Margin="10,0,0,0" ToolTip.Tip="Réafficher un panneau fermé, ou le mettre au premier plan" />
          <Button x:Name="ResetLayoutButton" Classes="target" Content="Rétablir la disposition" ToolTip.Tip="Oublier la disposition enregistrée et revenir à celle livrée" />
        </StackPanel>
        <StackPanel Orientation="Horizontal" Spacing="6" VerticalAlignment="Center">
          <Button Classes="target" Content="■ Stop" Foreground="#F85149"
                  Command="{Binding StopAllCommand}" CommandParameter="sauf-protegees"
                  ToolTip.Tip="Arrêter toutes les scènes, sauf les couches protégées (Ambiance par défaut : fumée, UV…). Réglage : écran Scènes → Couches…, colonne « Protégée »." />
          <Button Classes="target" Content="■ Tout stopper" Foreground="#F85149" Margin="0,0,10,0"
                  Command="{Binding StopAllCommand}" CommandParameter="tout"
                  ToolTip.Tip="Arrêter absolument toutes les scènes, couches protégées comprises (fin de soirée)" />
          <Button Classes="target lock" Classes.locked="{Binding IsLocked}" Content="🔒 Verrou soirée" Command="{Binding ToggleLockCommand}" Margin="0,0,10,0"
                        ToolTip.Tip="Verrou soirée : on ne fait plus que jouer et retoucher en direct ; l'ouverture de la fenêtre d'édition et la modification des scènes sont bloquées (anti-fausse manipulation). Bleu : verrou posé." />
          <TextBlock Text="{Binding Message}" Foreground="#D29922" VerticalAlignment="Center" Margin="4,0,0,0" TextTrimming="CharacterEllipsis" MaxWidth="700" />
        </StackPanel>
      </DockPanel>
    </Border>

    <!-- Bloc BPM (Q42) : source, valeur, TAP (touche T), ×2, ÷2, « 1 ici », compteur 1-2-3-4. -->
    <Border DockPanel.Dock="Top" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,0,0,1" Padding="10,4">
      <StackPanel Orientation="Horizontal" Spacing="6" DataContext="{Binding Tempo}" x:DataType="vm:TempoBarViewModel" VerticalAlignment="Center">
        <TextBlock Text="♪" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding BpmText}" FontSize="18" FontWeight="SemiBold" Width="56" TextAlignment="Right" VerticalAlignment="Center"
                   ToolTip.Tip="Tempo courant en battements par minute" />
        <TextBlock Text="BPM" Foreground="#8B949E" VerticalAlignment="Center" />
        <Button Classes="target" Content="−" MinWidth="30" Padding="6,4" Command="{Binding DecreaseCommand}" ToolTip.Tip="Retirer 1 BPM" />
        <Button Classes="target" Content="+" MinWidth="30" Padding="6,4" Command="{Binding IncreaseCommand}" ToolTip.Tip="Ajouter 1 BPM" />
        <Button Classes="target" Content="TAP" FontWeight="Bold" Command="{Binding TapCommand}"
                ToolTip.Tip="Taper le rythme : quatre frappes régulières donnent le tempo, chaque frappe cale le temps (touche T)" />
        <Button Classes="target" Content="×2" Padding="8,4" Command="{Binding TimesTwoCommand}" ToolTip.Tip="Doubler le tempo (corrige une détection à la moitié)" />
        <Button Classes="target" Content="÷2" Padding="8,4" Command="{Binding DivideByTwoCommand}" ToolTip.Tip="Diviser le tempo par deux" />
        <Button Classes="target" Content="1 ici" Padding="8,4" Command="{Binding ResyncBarCommand}" ToolTip.Tip="Le temps en cours devient le premier de la mesure" />
        <TextBlock Text="●" Foreground="{Binding Beat1}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat2}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat3}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="●" Foreground="{Binding Beat4}" FontSize="16" VerticalAlignment="Center" />
        <TextBlock Text="{Binding SourceText}" Foreground="#8B949E" VerticalAlignment="Center" Width="40"
                   ToolTip.Tip="Source du tempo : Fixe (saisi), Tap (tapé) ou Audio (musique écoutée)" />
        <TextBlock Text="{Binding Detail}" Foreground="#8B949E" VerticalAlignment="Center" FontSize="12" Width="92" TextTrimming="CharacterEllipsis" />
        <TextBox Text="{Binding BpmInput}" Width="64" MinHeight="34" VerticalContentAlignment="Center" PlaceholderText="BPM" ToolTip.Tip="Saisir un tempo fixe (puis « Fixer »)" />
        <Button Classes="target" Content="Fixer" Padding="8,4" Command="{Binding UseFixedCommand}" ToolTip.Tip="Utiliser le BPM saisi comme tempo fixe" />
        <Button Classes="target" Content="🎧 Audio" Padding="8,4" Command="{Binding UseAudioCommand}" IsEnabled="{Binding CanListen}"
                ToolTip.Tip="Suivre le tempo de la musique jouée sur ce PC (démarre l'écoute)" />
        <CheckBox Content="Écoute" IsChecked="{Binding Listening}" IsEnabled="{Binding CanListen}" VerticalAlignment="Center"
                  ToolTip.Tip="{Binding AudioStatus}" />
      </StackPanel>
    </Border>

    <!-- Retouches en direct : le seul rappel d'état de l'écran de jeu. Sa place est réservée en permanence : qu'il apparaisse ou
         disparaisse, rien ne bouge (essai 1.007.080 : la mise en page sautait sous la souris et le fader tenu clignotait). -->
    <Panel DockPanel.Dock="Top" Height="32">
      <Border Background="#D29922" Opacity="0.16" IsVisible="{Binding HasRetouches}" />
      <Border BorderBrush="{Binding RetouchBorder}" BorderThickness="0,1,0,1" Padding="10,0">
        <DockPanel VerticalAlignment="Center">
          <Button DockPanel.Dock="Right" Content="Libérer tout  (Échap)" MinHeight="26" Padding="10,0" FontSize="12"
                  BorderBrush="#D29922" BorderThickness="1" Foreground="#D29922" Background="Transparent"
                  IsVisible="{Binding HasRetouches}" Command="{Binding ReleaseAllCommand}" />
          <TextBlock Text="{Binding RetouchText}" VerticalAlignment="Center" FontSize="13" TextTrimming="CharacterEllipsis"
                     Foreground="{Binding RetouchForeground}" />
        </DockPanel>
      </Border>
    </Panel>

    <TextBlock DockPanel.Dock="Top" Text="Aucun projet ouvert : menu Projet → Ouvrir." IsVisible="{Binding !HasProject}" Margin="12,8" />
    <dockc:DockControl x:Name="DockHost" InitializeLayout="True" InitializeFactory="True" />
  </DockPanel>
</UserControl>
