<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Control"
             x:Class="Luxia.UI.Modules.Control.Views.LooksPanelView"
             x:DataType="vm:LooksPanelViewModel">
  <DockPanel Margin="8,32,8,6">
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,30,8">
      <Button Content="+ Capturer ce qui joue" Command="{Binding CaptureCommand}" IsEnabled="{Binding CanEdit}"
              ToolTip.Tip="Nouveau look qui refera ce qui joue maintenant : tout arrêter, relancer ces scènes, remettre les masters" />
    </StackPanel>
    <TextBlock DockPanel.Dock="Bottom" Text="{Binding Message}" Foreground="#D29922" TextWrapping="Wrap" />
    <TextBlock DockPanel.Dock="Top" IsVisible="{Binding IsEmpty}" TextWrapping="Wrap" Foreground="#8B949E" Margin="0,0,0,8"
               Text="Un look est une liste d'actions appelée d'un clic (« Temps mort » : tout arrêter, ambre, Grand Master à 40 %). Lancez des scènes, réglez les masters, puis « Capturer ce qui joue »." />
    <ScrollViewer>
      <ItemsControl ItemsSource="{Binding Looks}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <WrapPanel />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:LookButtonViewModel">
            <Button Width="150" MinHeight="56" Margin="0,0,6,6" Padding="8,6" HorizontalContentAlignment="Left" VerticalContentAlignment="Top"
                    BorderBrush="{Binding Color}" BorderThickness="4,0,0,0" ToolTip.Tip="{Binding Tip}"
                    Command="{Binding $parent[UserControl].((vm:LooksPanelViewModel)DataContext).PlayCommand}" CommandParameter="{Binding}"
                    ContextRequested="OnLookContext">
              <StackPanel>
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" TextWrapping="Wrap" />
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <TextBlock Text="{Binding Key}" FontSize="11" FontWeight="Bold" Foreground="#E3B341" />
                  <TextBlock Text="{Binding Lines.Count, StringFormat='{}{0} action(s)'}" FontSize="11" Foreground="#8B949E" />
                </StackPanel>
              </StackPanel>
            </Button>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
