<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Control"
             xmlns:c="using:Luxia.UI.Controls"
             xmlns:sc="using:Luxia.UI.Modules.Scenes"
             x:Class="Luxia.UI.Modules.Control.Views.PropertiesPanelView"
             x:DataType="vm:PropertiesPanelViewModel">
  <UserControl.Styles>
    <Style Selector="Border.section">
      <Setter Property="Background" Value="#161B22" />
      <Setter Property="CornerRadius" Value="8" />
      <Setter Property="Padding" Value="10,8" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
    <Style Selector="TextBlock.label">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Foreground" Value="#8B949E" />
      <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style Selector="Expander">
      <Setter Property="HorizontalAlignment" Value="Stretch" />
      <Setter Property="Margin" Value="0,0,0,8" />
    </Style>
  </UserControl.Styles>

  <DockPanel Margin="10,4,10,8">
    <!-- En-tête fixe : nom, essai (▶ Lancer, ■ Arrêter) et étapes restent à portée de main où qu'on soit dans les propriétés (essai 1.007.092). -->
    <StackPanel DockPanel.Dock="Top" IsVisible="{Binding HasScene}" IsEnabled="{Binding IsEditable}" Spacing="6" Margin="0,0,0,6">
      <Grid ColumnDefinitions="Auto,*" Margin="0,0,30,4">
        <Border Width="22" Height="22" CornerRadius="4" Background="{Binding Color}" Margin="0,0,8,0" />
        <TextBox Grid.Column="1" Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" ToolTip.Tip="Nom de la scène (enregistré à la frappe, Ctrl+Z pour annuler)" />
      </Grid>
      <TextBlock Text="{Binding Summary}" FontSize="12" Foreground="#8B949E" Margin="0,0,0,8" />
      <StackPanel Orientation="Horizontal" Spacing="6">
        <Button Content="▶ Lancer" MinHeight="32" Command="{Binding TestCommand}" ToolTip.Tip="Joue la scène avec le brouillon (les autres couches continuent), sans changer de mode" />
        <Button Content="■ Arrêter" MinHeight="32" Command="{Binding StopTestCommand}" />
      </StackPanel>
      <c:StepStrip x:Name="Strip" Items="{Binding Steps}" SelectedIndex="{Binding SelectedStep}" Accent="{Binding Accent}" />
      <WrapPanel>
        <Button Content="+ étape" Margin="0,0,4,4" Command="{Binding AddStepCommand}" ToolTip.Tip="Nouvelle étape vide après l'étape choisie" />
        <Button Content="Dupliquer" Margin="0,0,4,4" Command="{Binding DuplicateStepCommand}" />
        <Button Content="⇠ Déplacer" Margin="0,0,4,4" Command="{Binding MoveStepLeftCommand}" ToolTip.Tip="Déplacer l'étape choisie d'un rang vers la gauche (plus tôt dans la scène). Pour choisir une autre étape : clic dans la bande ou flèches ← →" />
        <Button Content="Déplacer ⇢" Margin="0,0,4,4" Command="{Binding MoveStepRightCommand}" ToolTip.Tip="Déplacer l'étape choisie d'un rang vers la droite (plus tard dans la scène)" />
        <Button Content="Supprimer" Margin="0,0,4,4" Foreground="#F85149" Command="{Binding DeleteStepCommand}" ToolTip.Tip="Il reste toujours une étape (Ctrl+Z pour annuler)" />
      </WrapPanel>
    </StackPanel>
    <TextBlock DockPanel.Dock="Top" Text="{Binding EmptyText}" IsVisible="{Binding !HasScene}" TextWrapping="Wrap" Foreground="#8B949E" Margin="4,4,30,8" />
    <ScrollViewer IsVisible="{Binding HasScene}">
      <StackPanel IsEnabled="{Binding IsEditable}">
        <Border IsVisible="{Binding ShowsModeHint}" Background="#1F58A6FF" BorderBrush="#58A6FF" BorderThickness="1" CornerRadius="6" Padding="8,6" Margin="0,0,0,8">
          <TextBlock TextWrapping="Wrap" FontSize="12"
                     Text="Scène choisie : vous pouvez déjà la renommer, changer ses étapes, sa vitesse… ci-dessous. Pour modifier ses couleurs, positions, intensités : ÉDITION (on la voit sur la sortie) ou 👁 AVEUGLE (sans toucher la sortie). En LIVE, les Réglages restent des retouches temporaires." />
        </Border>
        <ItemsControl ItemsSource="{x:Static vm:PropertiesPanelViewModel.Colors}" Margin="0,0,0,8">
          <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="x:String">
              <Button Width="22" Height="22" Padding="0" Margin="0,0,4,4" Background="{Binding}" CornerRadius="4"
                      ToolTip.Tip="Couleur de la scène"
                      Command="{Binding $parent[UserControl].((vm:PropertiesPanelViewModel)DataContext).SetColorCommand}" CommandParameter="{Binding}" />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>

        <!-- Lecture -->
        <Expander Header="Lecture" IsExpanded="False">
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="label" Text="Couche" />
            <ComboBox Grid.Column="1" ItemsSource="{Binding Layers}" SelectedItem="{Binding Layer}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="1" Classes="label" Text="Vitesse (%)" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding SpeedPercent}" Minimum="10" Maximum="1000" Increment="10" FormatString="0" Width="150" HorizontalAlignment="Left" />
            <TextBlock Grid.Row="2" Classes="label" Text="Enchaînement" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:PropertiesPanelViewModel.LoopOptions}" SelectedItem="{Binding Loop}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="3" Classes="label" Text="À la fin" />
            <ComboBox Grid.Row="3" Grid.Column="1" ItemsSource="{x:Static vm:PropertiesPanelViewModel.EndOptions}" SelectedItem="{Binding End}" HorizontalAlignment="Stretch" />
            <TextBlock Grid.Row="4" Classes="label" Text="Fondu d'entrée" />
            <StackPanel Grid.Row="4" Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding FadeIn}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" PlaceholderText="celui de l'étape" ToolTip.Tip="Vide : le fondu de la première étape" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
            <TextBlock Grid.Row="5" Classes="label" Text="Fondu de sortie" />
            <StackPanel Grid.Row="5" Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding FadeOut}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" PlaceholderText="immédiat" ToolTip.Tip="Vide : arrêt immédiat" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
            <CheckBox Grid.Row="6" Grid.Column="1" Content="Visible dans l'écran Live" IsChecked="{Binding VisibleInLive}" />
          </Grid>
        </Expander>

        <!-- Au rythme (MOT-017, MOT-018, MOT-020) : avancer, démarrer et battre au tempo de l'horloge musicale -->
        <Expander IsExpanded="False">
          <Expander.Header>
            <TextBlock Text="{Binding RhythmHeader}" TextWrapping="Wrap" ToolTip.Tip="{Binding RhythmHeader}" />
          </Expander.Header>
          <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Classes="label" Text="Étape suivante" />
            <ComboBox Grid.Column="1" ItemsSource="{x:Static vm:PropertiesPanelViewModel.AdvanceOptions}" SelectedItem="{Binding Advance}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="Ce qui fait passer à l'étape suivante : la durée de l'étape, ou un événement musical (les basses et aigus avancent au temps tant qu'aucune musique n'est écoutée)" />
            <TextBlock Grid.Row="1" Classes="label" Text="Fréquence" IsVisible="{Binding ShowFrequency}" />
            <ComboBox Grid.Row="1" Grid.Column="1" ItemsSource="{Binding Frequencies}" SelectedItem="{Binding Frequency}" HorizontalAlignment="Stretch" IsVisible="{Binding ShowFrequency}"
                      ToolTip.Tip="Combien d'étapes pour chaque événement : ×2 et ×4 passent deux ou quatre étapes par temps (ou par mesure) ; ÷ 2, ÷ 4, ÷ 8 n'en passent qu'une toutes les 2, 4, 8 fois. ×2 et ×4 ne s'appliquent pas aux basses et aux aigus." />
            <TextBlock Grid.Row="2" Classes="label" Text="Démarrage" />
            <ComboBox Grid.Row="2" Grid.Column="1" ItemsSource="{x:Static vm:PropertiesPanelViewModel.QuantizeOptions}" SelectedItem="{Binding Quantize}" HorizontalAlignment="Stretch"
                      ToolTip.Tip="La scène attend le temps, la mesure ou la phrase suivante pour démarrer ; un second clic pendant l'attente l'annule" />
            <CheckBox Grid.Row="5" Grid.Column="1" Content="La vitesse suit l'énergie de la musique" IsChecked="{Binding EnergySpeed}" IsVisible="{Binding ShowEnergySpeed}"
                      ToolTip.Tip="Plus la musique est énergique, plus la scène va vite (de 0,5× à 1,8×) ; sans écoute, vitesse normale" />
            <CheckBox Grid.Row="3" Grid.Column="1" Content="Horloge propre (tempo fixe de la scène)" IsChecked="{Binding HasOwnClock}" IsVisible="{Binding ShowOwnClock}"
                      ToolTip.Tip="La scène bat à son propre tempo au lieu de suivre la musique (mouvement lent à 30 BPM pendant que la musique est à 128)" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding OwnBpm}" Minimum="20" Maximum="400" Increment="1" FormatString="0.#" Width="150" HorizontalAlignment="Left"
                           IsEnabled="{Binding HasOwnClock}" IsVisible="{Binding ShowOwnClock}" />
          </Grid>
        </Expander>

        <!-- Assistants (SCN-014) -->
        <Expander Header="Assistant : générer les étapes" IsExpanded="False">
          <StackPanel Spacing="6">
            <TextBlock TextWrapping="Wrap" FontSize="11" Foreground="#8B949E"
                       Text="Choisissez les appareils sur le plan (ils sont pris de gauche à droite), cochez les couleurs ou positions dans l'ordre voulu, puis « Générer ». Les étapes de la scène sont remplacées ; Ctrl+Z pour revenir." />
            <ComboBox ItemsSource="{x:Static vm:PropertiesPanelViewModel.Wizards}" SelectedItem="{Binding Wizard}" HorizontalAlignment="Stretch" />
            <ItemsControl ItemsSource="{Binding WizardPalettes}">
              <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:WizardPaletteChip">
                  <ToggleButton IsChecked="{Binding IsChecked}" Margin="0,0,4,4" Padding="6,2" ToolTip.Tip="{Binding Name}">
                    <StackPanel Orientation="Horizontal" Spacing="4">
                      <Border Width="12" Height="12" CornerRadius="2" Background="{Binding Color}" />
                      <TextBlock Text="{Binding Name}" FontSize="11" />
                    </StackPanel>
                  </ToggleButton>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="Maintien" />
              <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding WizardHold}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
              <TextBlock Grid.Row="1" Classes="label" Text="Fondu" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding WizardFade}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
            </Grid>
            <Button Content="Générer les étapes" Command="{Binding GenerateStepsCommand}" />
            <TextBlock Text="{Binding WizardMessage}" TextWrapping="Wrap" FontSize="11" Foreground="#F0883E"
                       IsVisible="{Binding WizardMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
          </StackPanel>
        </Expander>

        <!-- Étape choisie -->
        <Expander Header="{Binding StepTitle}" IsExpanded="True">
          <StackPanel Spacing="6">
            <Grid ColumnDefinitions="120,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
              <TextBlock Classes="label" Text="Nom de l'étape" />
              <TextBox Grid.Column="1" Text="{Binding StepName}" PlaceholderText="(sans nom)" />
              <TextBlock Grid.Row="1" Classes="label" Text="Fondu" />
              <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding StepFade}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
              <TextBlock Grid.Row="2" Classes="label" Text="Maintien" />
              <StackPanel Grid.Row="2" Grid.Column="1" Orientation="Horizontal" Spacing="4" DataContext="{Binding StepHold}" x:DataType="sc:DurationField">
              <NumericUpDown Value="{Binding Amount}" Minimum="0" Maximum="600" Increment="0.5" FormatString="0.###" Width="115" />
              <ComboBox ItemsSource="{x:Static sc:DurationField.Units}" SelectedItem="{Binding Unit}" Width="95" ToolTip.Tip="Secondes, ou temps / mesures au tempo de l'horloge (la durée suit alors le tempo)" />
            </StackPanel>
              <CheckBox Grid.Row="4" Grid.Column="1" Content="Brève : passe d'elle-même (au rythme)" IsChecked="{Binding StepAutoAdvance}" IsVisible="{Binding ShowFrequency}"
                        ToolTip.Tip="Quand la scène avance sur un événement musical : cette étape ne l'attend pas, elle passe à la suivante au bout de son fondu et de son maintien. Pour un flash bref sur un kick : étape allumée brève, puis étape éteinte qui attend le kick suivant." />
              <CheckBox Grid.Row="3" Grid.Column="1" Content="Fondu par la teinte" IsChecked="{Binding StepHueFade}"
                        ToolTip.Tip="Pendant le fondu d'entrée de l'étape, les couleurs passent par la roue des teintes : rouge → vert passe par le jaune au lieu d'un brun terne (MOT-054)" />
            </Grid>
            <TextBlock Text="Contenu (réglé dans « Réglages des appareils », en ÉDITION ou AVEUGLE)" FontSize="11" Foreground="#8B949E" TextWrapping="Wrap" />
            <ItemsControl ItemsSource="{Binding StepValues}">
              <ItemsControl.ItemTemplate>
                <DataTemplate x:DataType="vm:StepValueRow">
                  <Grid ColumnDefinitions="18,110,*" Margin="0,2">
                    <Ellipse Width="10" Height="10" Fill="{Binding Color}" VerticalAlignment="Center" />
                    <TextBlock Grid.Column="1" Text="{Binding Who}" FontSize="12" TextTrimming="CharacterEllipsis" />
                    <TextBlock Grid.Column="2" Text="{Binding What}" FontSize="12" TextWrapping="Wrap" />
                  </Grid>
                </DataTemplate>
              </ItemsControl.ItemTemplate>
            </ItemsControl>
          </StackPanel>
        </Expander>

        <!-- Notes -->
        <Expander Header="Notes" IsExpanded="False">
          <TextBox Text="{Binding Notes}" AcceptsReturn="True" TextWrapping="Wrap" MinHeight="60" />
        </Expander>
      </StackPanel>
    </ScrollViewer>
  </DockPanel>
</UserControl>
