<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Simulator"
             xmlns:c="using:Luxia.UI.Controls"
             x:Class="Luxia.UI.Modules.Simulator.SimulatorView"
             x:DataType="vm:SimulatorViewModel">
  <DockPanel Margin="16">
    <TextBlock DockPanel.Dock="Top" Text="Simulateur" FontSize="22" FontWeight="SemiBold" Margin="0,0,0,8" />
    <TextBlock DockPanel.Dock="Top" Text="Ouvrez ou créez un projet et patchez des appareils pour voir le simulateur." Opacity="0.6"
               IsVisible="{Binding !HasProject}" Margin="0,0,0,8" />

    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8" IsVisible="{Binding HasProject}">
      <TextBlock Text="Lieu :" Opacity="0.6" />
      <TextBlock Text="{Binding VenueName}" FontWeight="SemiBold" />
      <TextBlock Text="Source :" Opacity="0.6" Margin="16,0,0,0" />
      <TextBlock Text="{Binding Source}" />
      <TextBlock Text="{Binding HoverText}" Opacity="0.8" Margin="16,0,0,0" />
    </StackPanel>

    <Border Classes="panel" IsVisible="{Binding HasProject}">
      <c:SimulatorCanvas x:Name="Canvas" RoomWidthM="{Binding RoomWidthM}" RoomDepthM="{Binding RoomDepthM}" />
    </Border>
  </DockPanel>
</UserControl>
