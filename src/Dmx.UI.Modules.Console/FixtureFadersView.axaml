<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dmx.UI.Modules.Console"
             xmlns:c="using:Dmx.UI.Controls"
             x:Class="Dmx.UI.Modules.Console.FixtureFadersView"
             x:DataType="vm:FixtureFadersViewModel">
  <DockPanel>
    <!-- Résumé et identification (CONS-024, CMD-023) -->
    <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Spacing="8" Margin="0,0,0,4">
      <TextBlock Text="{Binding Summary}" FontWeight="SemiBold" VerticalAlignment="Center" />
      <ToggleButton Content="Identifier" IsChecked="{Binding Identifying, Mode=OneWay}" Command="{Binding ToggleIdentifyCommand}"
                    ToolTip.Tip="Fait clignoter l'appareil (intensité) sans changer sa couleur ni sa position" />
    </StackPanel>

    <!-- Découverte (BIB-062) -->
    <Border DockPanel.Dock="Top" Classes="panel" Margin="0,0,0,6" IsVisible="{Binding DiscoveryChannel, Converter={x:Static ObjectConverters.IsNotNull}}">
      <WrapPanel Orientation="Horizontal">
        <TextBlock Text="{Binding DiscoveryText}" VerticalAlignment="Center" FontWeight="SemiBold" Margin="0,0,16,0" />
        <Button Content="◀ -1" Command="{Binding DiscoveryStepCommand}" CommandParameter="-1" Margin="0,0,4,0" />
        <Button Content="Pause / reprise" Command="{Binding ToggleDiscoveryCommand}" Margin="0,0,4,0" />
        <Button Content="+1 ▶" Command="{Binding DiscoveryStepCommand}" CommandParameter="1" Margin="0,0,12,0" />
        <TextBlock Text="Vitesse (valeurs/s)" VerticalAlignment="Center" Margin="0,0,4,0" />
        <NumericUpDown Value="{Binding DiscoverySpeed}" Minimum="1" Maximum="100" Increment="1" FormatString="0" Width="110" Margin="0,0,12,0" />
        <Button Content="Nouvelle plage ici" Command="{Binding NewBoundaryHereCommand}" Classes="accent" Margin="0,0,4,0"
                ToolTip.Tip="Crée une borne de plage à la valeur courante dans la définition du canal" />
        <Button Content="Terminer" Command="{Binding StopDiscoveryCommand}" />
      </WrapPanel>
    </Border>

    <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
      <ItemsControl ItemsSource="{Binding Channels}">
        <ItemsControl.ItemsPanel>
          <ItemsPanelTemplate>
            <StackPanel Orientation="Horizontal" Spacing="6" />
          </ItemsPanelTemplate>
        </ItemsControl.ItemsPanel>
        <ItemsControl.ItemTemplate>
          <DataTemplate x:DataType="vm:FixtureChannelViewModel">
            <Border Classes="panel" Width="150" Padding="6">
              <StackPanel Spacing="4">
                <TextBlock Text="{Binding Header}" FontSize="11" Opacity="0.6" />
                <TextBlock Text="{Binding Title}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" ToolTip.Tip="{Binding Title}" />
                <TextBlock Text="{Binding AttributeLabel}" FontSize="11" Opacity="0.7" />
                <c:Fader Height="150" Width="40" HorizontalAlignment="Center" Tag="{Binding}"
                         Value="{Binding Value}" IsOverridden="{Binding IsOverridden}" IsSelected="{Binding IsDiscovering}"
                         ValueRequested="OnFaderValueRequested" />
                <c:RangeBar Height="16" Segments="{Binding Segments}" CurrentValue="{Binding Value}" IsEditable="False" Tag="{Binding}"
                            SegmentClicked="OnRangeBarClicked" BoundaryClicked="OnRangeBarBoundaryClicked"
                            ToolTip.Tip="Clic : valeur sous la souris ; clic sur une frontière : valeur exacte de la borne" />
                <TextBlock Text="{Binding CurrentRange}" FontSize="11" TextWrapping="Wrap" MinHeight="30" />
                <Button Content="Découvrir…" Tag="{Binding}" Click="OnDiscoverClicked" HorizontalAlignment="Stretch"
                        ToolTip.Tip="Balayage lent de 0 à 255 pour construire les plages d'un canal inconnu" />
                <ItemsControl ItemsSource="{Binding Ranges}" IsVisible="{Binding HasRanges}">
                  <ItemsControl.ItemTemplate>
                    <DataTemplate x:DataType="vm:RangeButton">
                      <Button Content="{Binding Text}" FontSize="10" Padding="4,2" Margin="0,1" HorizontalAlignment="Stretch"
                              HorizontalContentAlignment="Left" Tag="{Binding}" Click="OnRangeButtonClicked"
                              ToolTip.Tip="Émet la valeur médiane de la plage" />
                    </DataTemplate>
                  </ItemsControl.ItemTemplate>
                </ItemsControl>
              </StackPanel>
            </Border>
          </DataTemplate>
        </ItemsControl.ItemTemplate>
      </ItemsControl>
    </ScrollViewer>
  </DockPanel>
</UserControl>
