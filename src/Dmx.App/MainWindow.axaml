<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:Dmx.App.ViewModels"
        xmlns:console="using:Dmx.UI.Modules.Console"
        xmlns:outputs="using:Dmx.UI.Modules.Outputs"
        xmlns:library="using:Dmx.UI.Modules.Library"
        xmlns:installation="using:Dmx.UI.Modules.Installation"
        xmlns:simulator="using:Dmx.UI.Modules.Simulator"
        x:Class="Dmx.App.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Title="{Binding Title}"
        Width="1400" Height="900"
        MinWidth="900" MinHeight="600">
  <DockPanel>
    <!-- Menu -->
    <Menu DockPanel.Dock="Top">
      <MenuItem Header="_Projet">
        <MenuItem Header="_Nouveau…" Command="{Binding NewProjectCommand}" />
        <MenuItem Header="_Ouvrir…" Command="{Binding OpenProjectCommand}" />
      </MenuItem>
    </Menu>

    <!-- Barre d'état permanente (GEN-104) -->
    <Border DockPanel.Dock="Bottom" Background="#161B22" BorderBrush="#30363D" BorderThickness="0,1,0,0" Padding="12,4">
      <DockPanel>
        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Spacing="8">
          <Ellipse Width="10" Height="10" Fill="{Binding OutputColor}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding OutputStatus}" VerticalAlignment="Center" />
          <TextBlock Text="{Binding FramesPerSecond}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
          <TextBlock Text="{Binding EngineIndicators}" VerticalAlignment="Center" Opacity="0.7" Margin="12,0,0,0" />
        </StackPanel>
        <TextBlock DockPanel.Dock="Right" Text="{Binding ProjectName}" VerticalAlignment="Center" HorizontalAlignment="Right" />
        <TextBlock Text="{Binding ProjectMessage}" Foreground="#D29922" VerticalAlignment="Center" HorizontalAlignment="Center" TextTrimming="CharacterEllipsis" />
      </DockPanel>
    </Border>

    <!-- Navigation -->
    <Border DockPanel.Dock="Left" Background="#0D1117" BorderBrush="#30363D" BorderThickness="0,0,1,0" Width="170">
      <ListBox ItemsSource="{Binding Pages}" SelectedItem="{Binding SelectedPage}" Background="Transparent" Margin="0,8">
        <ListBox.ItemTemplate>
          <DataTemplate x:DataType="vm:NavigationItem">
            <StackPanel Orientation="Horizontal" Spacing="10">
              <TextBlock Text="{Binding Glyph}" Width="18" TextAlignment="Center" />
              <TextBlock Text="{Binding Title}" />
            </StackPanel>
          </DataTemplate>
        </ListBox.ItemTemplate>
      </ListBox>
    </Border>

    <!-- Écran courant -->
    <ContentControl Content="{Binding SelectedPage.Page}">
      <ContentControl.DataTemplates>
        <DataTemplate DataType="console:ConsoleViewModel">
          <console:ConsoleView />
        </DataTemplate>
        <DataTemplate DataType="library:LibraryViewModel">
          <library:LibraryView />
        </DataTemplate>
        <DataTemplate DataType="installation:InstallationViewModel">
          <installation:InstallationView />
        </DataTemplate>
        <DataTemplate DataType="simulator:SimulatorViewModel">
          <simulator:SimulatorView />
        </DataTemplate>
        <DataTemplate DataType="outputs:OutputsViewModel">
          <outputs:OutputsView />
        </DataTemplate>
      </ContentControl.DataTemplates>
    </ContentControl>
  </DockPanel>
</Window>
