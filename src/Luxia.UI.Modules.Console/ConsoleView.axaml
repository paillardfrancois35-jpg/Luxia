<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Console"
             xmlns:c="using:Luxia.UI.Controls"
             x:Class="Luxia.UI.Modules.Console.ConsoleView"
             x:DataType="vm:ConsoleViewModel">
  <Grid RowDefinitions="Auto,Auto,*,Auto,220" ColumnDefinitions="*,260" Margin="16">

    <!-- En-tête : univers, pages, commandes globales (CONS-001, 004, 009) -->
    <WrapPanel Grid.Row="0" Grid.ColumnSpan="2" Orientation="Horizontal" Margin="0,0,0,8">
      <TextBlock Text="Console" FontSize="22" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,24,0" />
      <TextBlock Text="Mode" VerticalAlignment="Center" Margin="0,0,6,0" />
      <RadioButton GroupName="consoleMode" Content="Canaux" IsChecked="{Binding !IsDeviceMode}" VerticalAlignment="Center" Margin="0,0,8,0" />
      <RadioButton GroupName="consoleMode" Content="Appareils" IsChecked="{Binding IsDeviceMode}" VerticalAlignment="Center" Margin="0,0,16,0" />
      <TextBlock Text="Univers" VerticalAlignment="Center" Margin="0,0,6,0" />
      <ComboBox ItemsSource="{Binding Universes}" SelectedItem="{Binding SelectedUniverse}" MinWidth="60" Margin="0,0,16,0" />
      <StackPanel Orientation="Horizontal" IsVisible="{Binding !IsDeviceMode}">
        <Button Content="◀" Command="{Binding PreviousPageCommand}" ToolTip.Tip="Page précédente" />
        <TextBlock Text="{Binding PageLabel}" VerticalAlignment="Center" MinWidth="70" TextAlignment="Center" FontWeight="SemiBold" />
        <Button Content="▶" Command="{Binding NextPageCommand}" ToolTip.Tip="Page suivante" Margin="0,0,16,0" />
        <Button Content="Page à 0" Command="{Binding PageToZeroCommand}" Margin="0,0,4,0" />
        <Button Content="Page à 255" Command="{Binding PageToFullCommand}" Margin="0,0,16,0" />
        <Button Content="Libérer la sélection" Command="{Binding ReleaseSelectionCommand}" Margin="0,0,4,0" />
        <Button Content="Libérer la page" Command="{Binding ReleasePageCommand}" Margin="0,0,4,0" />
      </StackPanel>
      <Button Content="Tout libérer" Command="{Binding ReleaseAllCommand}" Classes="accent" />
    </WrapPanel>

    <StackPanel Grid.Row="1" Grid.ColumnSpan="2" Orientation="Horizontal" Spacing="16" Margin="0,0,0,8" IsVisible="{Binding !IsDeviceMode}">
      <CheckBox Content="Sélection : déplacement relatif" IsChecked="{Binding IsRelative}"
                ToolTip.Tip="Coché : les faders sélectionnés bougent du même écart. Décoché : ils prennent tous la même valeur." />
      <Button Content="Désélectionner" Command="{Binding ClearSelectionCommand}" />
      <TextBlock Text="{Binding Summary}" VerticalAlignment="Center" Opacity="0.7" />
      <TextBlock Text="{Binding Message}" VerticalAlignment="Center" Foreground="#58A6FF" />
    </StackPanel>

    <!-- Faders de la page (mode canaux, CONS-001) -->
    <Border Grid.Row="2" Grid.Column="0" Classes="panel" x:Name="FaderArea" Padding="6" IsVisible="{Binding !IsDeviceMode}">
      <DockPanel>
        <!-- CONS-007 : texte complet du canal survolé (la tranche, étroite, coupe les noms ; essai P6). -->
        <TextBlock DockPanel.Dock="Bottom" Text="{Binding HoveredDetail}" FontSize="12" Margin="4,6,4,0" TextTrimming="CharacterEllipsis" Foreground="#C9D1D9" />
        <ItemsControl ItemsSource="{Binding Channels}">
          <ItemsControl.ItemsPanel>
            <ItemsPanelTemplate>
              <StackPanel Orientation="Horizontal" />
            </ItemsPanelTemplate>
          </ItemsControl.ItemsPanel>
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:ChannelViewModel">
              <vm:ChannelStrip />
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </DockPanel>
    </Border>

    <!-- Faders par appareil (mode appareils, CONS-020 à 024) -->
    <Border Grid.Row="2" Grid.Column="0" Classes="panel" Padding="6" IsVisible="{Binding IsDeviceMode}">
      <ScrollViewer VerticalScrollBarVisibility="Auto">
        <ItemsControl ItemsSource="{Binding DeviceFixtures}">
          <ItemsControl.ItemTemplate>
            <DataTemplate x:DataType="vm:FixtureFadersViewModel">
              <Border Classes="panel" Margin="0,0,0,8" Padding="6">
                <vm:FixtureFadersView />
              </Border>
            </DataTemplate>
          </ItemsControl.ItemTemplate>
        </ItemsControl>
      </ScrollViewer>
    </Border>

    <!-- Instantanés (CONS-010) -->
    <Border Grid.Row="2" Grid.RowSpan="3" Grid.Column="1" Classes="panel" Margin="8,0,0,0">
      <DockPanel>
        <TextBlock DockPanel.Dock="Top" Classes="section" Text="Instantanés" Margin="0,0,0,6" />
        <TextBlock DockPanel.Dock="Top" Text="Ouvrez ou créez un projet (menu Projet) pour mémoriser des instantanés."
                   TextWrapping="Wrap" Opacity="0.6" IsVisible="{Binding !HasProject}" />
        <StackPanel DockPanel.Dock="Bottom" Spacing="4" Margin="0,6,0,0">
          <Button Content="Rappeler" Command="{Binding RecallSnapshotCommand}" CommandParameter="{Binding SelectedSnapshot}" HorizontalAlignment="Stretch" />
          <Button Content="Mémoriser les faders pris…" Command="{Binding SaveSnapshotCommand}" HorizontalAlignment="Stretch" />
          <Button Content="Supprimer…" Command="{Binding DeleteSnapshotCommand}" HorizontalAlignment="Stretch" />
        </StackPanel>
        <ListBox ItemsSource="{Binding Snapshots}" SelectedItem="{Binding SelectedSnapshot}" x:Name="SnapshotList">
          <ListBox.ItemTemplate>
            <DataTemplate x:DataType="vm:SnapshotViewModel">
              <StackPanel ToolTip.Tip="{Binding Description}">
                <TextBlock Text="{Binding Name}" FontWeight="SemiBold" />
                <TextBlock Text="{Binding Detail}" FontSize="11" Opacity="0.6" />
              </StackPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Border>

    <!-- Moniteur de sortie (CONS-040, 041, 043) -->
    <StackPanel Grid.Row="3" Grid.Column="0" Orientation="Horizontal" Spacing="16" Margin="0,8,0,4">
      <TextBlock Classes="section" Text="Moniteur de sortie" />
      <CheckBox Content="Valeurs" IsChecked="{Binding ShowValues}" />
      <TextBlock Text="{Binding HoverText}" VerticalAlignment="Center" Opacity="0.8" />
    </StackPanel>
    <c:OutputMonitor Grid.Row="4" Grid.Column="0" x:Name="Monitor" ShowValues="{Binding ShowValues}" />
  </Grid>
</UserControl>
