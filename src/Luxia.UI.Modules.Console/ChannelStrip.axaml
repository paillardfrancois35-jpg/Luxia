<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Console"
             xmlns:c="using:Luxia.UI.Controls"
             x:Class="Luxia.UI.Modules.Console.ChannelStrip"
             x:DataType="vm:ChannelViewModel"
             Width="42">
  <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" Margin="2,0">
    <TextBlock Grid.Row="0" Text="{Binding ChannelText}" HorizontalAlignment="Center" FontWeight="SemiBold" />
    <TextBlock Grid.Row="1" Text="{Binding Caption}" HorizontalAlignment="Center" FontSize="10" Opacity="0.6" TextTrimming="CharacterEllipsis" />
    <c:Fader Grid.Row="2" x:Name="Fader" Margin="3,4" MinHeight="120"
             Value="{Binding Value}" IsOverridden="{Binding IsOverridden}" IsSelected="{Binding IsSelected}" />
    <TextBox Grid.Row="3" x:Name="ValueBox" Text="{Binding ValueText}" FontSize="11" Padding="2" MinWidth="0"
             HorizontalContentAlignment="Center" ToolTip.Tip="Saisie directe : valeur 0-255 puis Entrée" />
    <TextBlock Grid.Row="4" Text="{Binding PercentText}" HorizontalAlignment="Center" FontSize="10" Opacity="0.6" />
  </Grid>
</UserControl>
