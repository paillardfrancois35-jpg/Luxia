<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Luxia.UI.Modules.Audio"
             x:Class="Luxia.UI.Modules.Audio.AudioView"
             x:DataType="vm:AudioViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="14" MaxWidth="1100" HorizontalAlignment="Left">

      <TextBlock Text="Audio" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="LuXia écoute la musique jouée sur ce PC (Deezer, YouTube Music, VLC…) : tempo, impulsions et énergie se règlent ici ; le bloc BPM de l'écran Contrôle reste le réglage de jeu."
                 TextWrapping="Wrap" Opacity="0.8" />
      <TextBlock Text="{Binding Message}" Foreground="#58A6FF" TextWrapping="Wrap"
                 IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Écoute et périphérique (AUD-001 à 003) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Écoute" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <CheckBox Content="Écouter et suivre le tempo" IsChecked="{Binding Listening}" IsEnabled="{Binding Available}"
                      ToolTip.Tip="Même interrupteur que « Audio » de l'écran de jeu : écoute le son du PC et suit son tempo. Mémorisé : l'écoute redémarre avec l'application." />
            <TextBlock Text="{Binding Status}" VerticalAlignment="Center" Opacity="0.8" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Périphérique" VerticalAlignment="Center" Width="100" />
            <ComboBox ItemsSource="{Binding Devices}" SelectedItem="{Binding SelectedDevice}" Width="520"
                      ToolTip.Tip="Le son joué par le PC (par défaut), la sortie d'un autre périphérique, ou une entrée : micro USB, ligne. Un micro capte aussi la salle : tempo et drops sont moins précis." />
            <Button Content="Actualiser" Command="{Binding RefreshDevicesCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Ce qui est entendu (AUD-080) : largeurs fixes, rien ne bouge quand les valeurs changent. -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Ce que LuXia entend" />
          <Grid ColumnDefinitions="100,420,30,130,300" RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="8">
            <TextBlock Text="Niveau" VerticalAlignment="Center" />
            <ProgressBar Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Level}" Height="14" />
            <TextBlock Grid.Row="1" Text="Basses" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="1" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Bass}" Height="14" Foreground="#F0883E" />
            <TextBlock Grid.Row="2" Text="Médiums" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="2" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Mid}" Height="14" Foreground="#3FB950" />
            <TextBlock Grid.Row="3" Text="Aigus" VerticalAlignment="Center" />
            <ProgressBar Grid.Row="3" Grid.Column="1" Minimum="0" Maximum="1" Value="{Binding Treble}" Height="14" Foreground="#A371F7" />
            <TextBlock Grid.Column="3" Text="Impulsion basses" VerticalAlignment="Center" FontSize="12" />
            <ProgressBar Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding BassFlash}" Height="14" Foreground="#F0883E"
                         ToolTip.Tip="S'allume à chaque kick détecté (AUD-040)" />
            <TextBlock Grid.Row="1" Grid.Column="3" Text="Impulsion aigus" VerticalAlignment="Center" FontSize="12" />
            <ProgressBar Grid.Row="1" Grid.Column="4" Minimum="0" Maximum="1" Value="{Binding TrebleFlash}" Height="14" Foreground="#A371F7"
                         ToolTip.Tip="S'allume à chaque caisse claire ou charleston détecté (AUD-040)" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Tempo (signal A) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Tempo" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <TextBlock Text="{Binding BpmText}" FontSize="28" FontWeight="SemiBold" Width="110" TextAlignment="Right" VerticalAlignment="Center" />
            <TextBlock Text="BPM" Opacity="0.7" VerticalAlignment="Center" Width="40" />
            <TextBlock Text="confiance" Opacity="0.7" VerticalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Confidence}" Width="160" Height="12" VerticalAlignment="Center"
                         ToolTip.Tip="En dessous de 30 %, l'horloge garde son dernier tempo (AUD-022)" />
            <TextBlock Text="{Binding ConfidenceText}" Width="50" VerticalAlignment="Center" />
            <TextBlock Text="temps" Opacity="0.7" VerticalAlignment="Center" />
            <TextBlock Text="{Binding BeatText}" FontSize="22" Width="28" VerticalAlignment="Center" />
            <TextBlock Text="●" Foreground="{Binding Beat1}" FontSize="18" VerticalAlignment="Center" ToolTip.Tip="Temps 1 de la mesure (orange)" />
            <TextBlock Text="●" Foreground="{Binding Beat2}" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="●" Foreground="{Binding Beat3}" FontSize="18" VerticalAlignment="Center" />
            <TextBlock Text="●" Foreground="{Binding Beat4}" FontSize="18" VerticalAlignment="Center" />
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding BeatPhase}" Width="100" Height="12" VerticalAlignment="Center" />
            <TextBlock Text="{Binding SourceText}" Opacity="0.7" Width="60" VerticalAlignment="Center" ToolTip.Tip="Source du tempo de l'horloge" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="×2" Width="48" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding TimesTwoCommand}" ToolTip.Tip="Corrige un tempo détecté à la moitié" />
            <Button Content="÷ 2" Width="48" FontSize="16" FontWeight="Bold" HorizontalContentAlignment="Center" Command="{Binding DivideByTwoCommand}" ToolTip.Tip="Corrige un tempo détecté au double" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Énergie (signal C) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Énergie" />
          <StackPanel Orientation="Horizontal" Spacing="10">
            <ProgressBar Minimum="0" Maximum="1" Value="{Binding Energy}" Width="320" Height="16" VerticalAlignment="Center" />
            <TextBlock Text="{Binding EnergyText}" FontSize="18" Width="110" VerticalAlignment="Center" />
            <TextBlock Text="{Binding TrendText}" Width="90" VerticalAlignment="Center" Opacity="0.8" />
            <TextBlock Text="{Binding BreakText}" Foreground="#F85149" FontWeight="Bold" Width="70" VerticalAlignment="Center" />
          </StackPanel>
          <TextBlock Text="Derniers événements" Opacity="0.7" />
          <ItemsControl ItemsSource="{Binding Events}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="x:String">
                <TextBlock Text="{Binding}" FontFamily="Consolas,monospace" />
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Réglages (AUD-081) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Réglages" />
          <Grid ColumnDefinitions="230,150,*" RowDefinitions="Auto,Auto,Auto,Auto,Auto,Auto" RowSpacing="6">
            <TextBlock Text="Sensibilité des impulsions (%)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Column="1" Value="{Binding Sensitivity}" Minimum="0" Maximum="100" Increment="5" FormatString="0" />
            <TextBlock Grid.Column="2" Margin="10,0,0,0" Opacity="0.6" VerticalAlignment="Center" Text="Plus haut : plus d'impulsions (et de fausses détections)" />
            <TextBlock Grid.Row="1" Text="Lissage de l'énergie (s)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="1" Grid.Column="1" Value="{Binding Smoothing}" Minimum="0.5" Maximum="8" Increment="0.5" FormatString="0.0" />
            <TextBlock Grid.Row="2" Text="Tempo minimal (BPM)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="2" Grid.Column="1" Value="{Binding MinBpm}" Minimum="40" Maximum="170" Increment="5" FormatString="0" />
            <TextBlock Grid.Row="3" Text="Tempo maximal (BPM)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="3" Grid.Column="1" Value="{Binding MaxBpm}" Minimum="80" Maximum="240" Increment="5" FormatString="0" />
            <TextBlock Grid.Row="4" Text="Tempo préféré (BPM)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="4" Grid.Column="1" Value="{Binding PreferredBpm}" Minimum="60" Maximum="200" Increment="5" FormatString="0" />
            <TextBlock Grid.Row="4" Grid.Column="2" Margin="10,0,0,0" Opacity="0.6" VerticalAlignment="Center" Text="En cas de doute entre un tempo et son double ou sa moitié, LuXia préfère celui le plus proche" />
            <TextBlock Grid.Row="5" Text="Latence (ms)" VerticalAlignment="Center" />
            <NumericUpDown Grid.Row="5" Grid.Column="1" Value="{Binding LatencyMilliseconds}" Minimum="-500" Maximum="500" Increment="10" FormatString="0" />
            <TextBlock Grid.Row="5" Grid.Column="2" Margin="10,0,0,0" Opacity="0.6" VerticalAlignment="Center" Text="Positif : la lumière avance sur le son ; négatif : elle retarde" />
          </Grid>
        </StackPanel>
      </Border>

      <!-- Calibration de la latence (AUD-027) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Calibration de la latence" />
          <TextBlock TextWrapping="Wrap" Opacity="0.8"
                     Text="Lancez un morceau au rythme net, puis le flash : les appareils flashent à chaque temps de l'horloge. Réglez la latence ci-dessus jusqu'à ce que le flash tombe sur le kick, puis arrêtez." />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="▶ Lancer le flash sur chaque temps" Command="{Binding StartCalibrationCommand}" />
            <Button Content="■ Arrêter" Command="{Binding StopCalibrationCommand}" />
            <Button Content="Latence à zéro" Command="{Binding ResetLatencyCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
