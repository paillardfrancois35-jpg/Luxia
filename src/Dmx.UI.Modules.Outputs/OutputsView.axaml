<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Dmx.UI.Modules.Outputs"
             x:Class="Dmx.UI.Modules.Outputs.OutputsView"
             x:DataType="vm:OutputsViewModel">
  <ScrollViewer>
    <StackPanel Margin="16" Spacing="16">

      <TextBlock Text="Sorties" FontSize="22" FontWeight="SemiBold" />
      <TextBlock Text="{Binding EngineStatus}" Opacity="0.8" />
      <TextBlock Text="{Binding Message}" Foreground="#58A6FF" IsVisible="{Binding Message, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />
      <TextBlock Text="{Binding PreferencesMessage}" Foreground="#D29922" TextWrapping="Wrap"
                 IsVisible="{Binding PreferencesMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}" />

      <!-- Pilotes (SORT-004) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Pilotes" />
          <Grid ColumnDefinitions="220,110,*,90,70,90" Opacity="0.6">
            <TextBlock Grid.Column="0" Text="Pilote" />
            <TextBlock Grid.Column="1" Text="État" />
            <TextBlock Grid.Column="2" Text="Détail" />
            <TextBlock Grid.Column="3" Text="Trames/s" />
            <TextBlock Grid.Column="4" Text="Erreurs" />
            <TextBlock Grid.Column="5" Text="Écriture" />
          </Grid>
          <ItemsControl ItemsSource="{Binding Drivers}">
            <ItemsControl.ItemTemplate>
              <DataTemplate x:DataType="vm:DriverStatusViewModel">
                <Grid ColumnDefinitions="220,110,*,90,70,90" Margin="0,2">
                  <TextBlock Grid.Column="0" Text="{Binding Name}" />
                  <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="6">
                    <Ellipse Width="10" Height="10" Fill="{Binding StateColor}" VerticalAlignment="Center" />
                    <TextBlock Text="{Binding State}" />
                  </StackPanel>
                  <TextBlock Grid.Column="2" Text="{Binding Detail}" TextTrimming="CharacterEllipsis" />
                  <TextBlock Grid.Column="3" Text="{Binding FramesPerSecond}" />
                  <TextBlock Grid.Column="4" Text="{Binding Errors}" />
                  <TextBlock Grid.Column="5" Text="{Binding WriteDuration}" />
                </Grid>
              </DataTemplate>
            </ItemsControl.ItemTemplate>
          </ItemsControl>
        </StackPanel>
      </Border>

      <!-- Arduino (SORT-010 à 015, SORT-021) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Arduino" />
          <WrapPanel Orientation="Horizontal">
            <StackPanel Classes="field">
              <TextBlock Text="Port" />
              <StackPanel Orientation="Horizontal" Spacing="4">
                <ComboBox ItemsSource="{Binding Ports}" SelectedItem="{Binding SelectedPort}" MinWidth="160" />
                <Button Content="↻" Command="{Binding RefreshPortsCommand}" ToolTip.Tip="Relire la liste des ports" />
              </StackPanel>
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Text="Canaux émis" />
              <NumericUpDown Value="{Binding ChannelCount}" Minimum="1" Maximum="512" Increment="1" FormatString="0" Width="130" />
            </StackPanel>
            <StackPanel Classes="field" VerticalAlignment="Bottom">
              <CheckBox Content="Ancien firmware POC (port imposé)" IsChecked="{Binding LegacyProtocol}" />
              <CheckBox Content="Sonder aussi les ports non Arduino" IsChecked="{Binding ProbeAllPorts}" />
            </StackPanel>
          </WrapPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Appliquer" Command="{Binding ApplyArduinoCommand}" />
            <Button Content="Reconnecter" Command="{Binding ReconnectCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Test de sortie (SORT-007, CMD-024) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Test de sortie (chenillard canal par canal)" />
          <WrapPanel Orientation="Horizontal">
            <StackPanel Classes="field">
              <TextBlock Text="Canaux" />
              <TextBox Text="{Binding TestRange}" Width="110" Watermark="1-16" />
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Text="Canaux exclus" />
              <TextBox Text="{Binding TestExcluded}" Width="160" Watermark="180" />
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Text="Valeur (%)" />
              <NumericUpDown Value="{Binding TestValuePercent}" Minimum="0" Maximum="100" Increment="5" FormatString="0" Width="130" />
            </StackPanel>
            <StackPanel Classes="field">
              <TextBlock Text="Durée par canal (ms)" />
              <NumericUpDown Value="{Binding TestStepMilliseconds}" Minimum="50" Maximum="60000" Increment="100" FormatString="0" Width="150" />
            </StackPanel>
          </WrapPanel>
          <TextBlock Text="La fumée (canal 180) est exclue par défaut ; valeur modérée pour ne pas déclencher les canaux Reset / contrôle." Opacity="0.6" TextWrapping="Wrap" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <Button Content="Démarrer le test" Command="{Binding StartTestCommand}" />
            <Button Content="Arrêter" Command="{Binding StopTestCommand}" />
            <TextBlock Text="{Binding TestStatus}" VerticalAlignment="Center" Margin="8,0" />
          </StackPanel>
        </StackPanel>
      </Border>

      <!-- Enregistreur (SORT-060, SORT-061) et cadence (GEN-030) -->
      <Border Classes="panel">
        <StackPanel Spacing="8">
          <TextBlock Classes="section" Text="Enregistreur et cadence" />
          <StackPanel Orientation="Horizontal" Spacing="8">
            <ToggleButton Content="Enregistrer les trames" IsChecked="{Binding Recording, Mode=OneWay}" Command="{Binding ToggleRecordingCommand}" />
            <TextBlock Text="{Binding RecordingStatus}" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Orientation="Horizontal" Spacing="8">
            <TextBlock Text="Fréquence du moteur (Hz)" VerticalAlignment="Center" />
            <NumericUpDown Value="{Binding TickRate}" Minimum="25" Maximum="44" Increment="1" FormatString="0.0" Width="130" />
            <Button Content="Appliquer" Command="{Binding ApplyTickRateCommand}" />
          </StackPanel>
        </StackPanel>
      </Border>

    </StackPanel>
  </ScrollViewer>
</UserControl>
