<Project>
  <!-- RÃ©glages communs Ã  tous les projets (doc 03 Â§4). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <Company>LuXia</Company>
    <Product>LuXia</Product>
    <Version>1.010</Version>
    <!--
      GEN-119 : pendant le dÃ©veloppement d'un passage non encore validÃ©, l'application affiche Â« v<LuxiaDevVersion>.NNN Â»,
      NNN augmentant Ã  chaque compilation (cible LuxiaBuildNumber de Luxia.App), comme les Ã©tiquettes v1.0NN.MMM (doc 03 Â§7).
      Ã€ la validation : Version = cette valeur, LuxiaDevVersion vidÃ©.
    -->
    <LuxiaDevVersion>1.011</LuxiaDevVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Projets de tests : documentation XML non exigÃ©e. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
