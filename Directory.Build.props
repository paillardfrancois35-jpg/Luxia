<Project>
  <!-- Réglages communs à tous les projets (doc 03 §4). -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <AnalysisLevel>latest</AnalysisLevel>
    <AnalysisMode>Recommended</AnalysisMode>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <Deterministic>true</Deterministic>
    <NeutralLanguage>fr-FR</NeutralLanguage>
    <SatelliteResourceLanguages>fr</SatelliteResourceLanguages>
    <Company>LuXia</Company>
    <Product>LuXia</Product>
    <Version>1.007</Version>
    <!--
      GEN-119 : pendant le développement d'un passage non encore validé, l'application affiche « v<LuxiaDevVersion>.NNN »,
      NNN augmentant à chaque compilation (cible LuxiaBuildNumber de Luxia.App), comme les étiquettes v1.0NN.MMM (doc 03 §7).
      À la validation : Version = cette valeur, LuxiaDevVersion vidé.
    -->
    <LuxiaDevVersion></LuxiaDevVersion>
    <IncludeSourceRevisionInInformationalVersion>false</IncludeSourceRevisionInInformationalVersion>
  </PropertyGroup>

  <!-- Projets de tests : documentation XML non exigée. -->
  <PropertyGroup Condition="$(MSBuildProjectName.EndsWith('.Tests'))">
    <IsPackable>false</IsPackable>
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>
</Project>
