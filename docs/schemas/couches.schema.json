{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxia.local/schemas/couches.schema.json",
  "title": "LuXia – couches.json (format 1)",
  "description": "Couches d'un projet (doc 17 §1, doc 50 §12).",
  "type": "object",
  "required": ["formatVersion", "layers"],
  "properties": {
    "formatVersion": { "const": 1 },
    "layers": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "priority"],
        "properties": {
          "id": { "type": "string" },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "pattern": "^#[0-9a-fA-F]{6}$" },
          "icon": { "type": ["string", "null"] },
          "priority": { "type": "integer" },
          "exclusive": { "type": "boolean" },
          "master": { "type": "number", "minimum": 0, "maximum": 1 },
          "intensityMode": { "enum": ["htp", "priority", "additive", "multiplicative"] },
          "masterOnAllAttributes": { "type": "boolean" },
          "kind": { "enum": ["normal", "flash"], "description": "flash : scènes actives tant que maintenues (COU-005)" },
          "keepOnStopAll": { "type": "boolean", "description": "épargnée par « Tout arrêter » (COU-007)" },
          "restSceneId": { "type": ["string", "null"], "description": "scène jouée quand la couche n'a plus de scène (COU-009)" },
          "families": {
            "type": "array",
            "description": "familles d'attributs attendues ; une scène qui en touche d'autres est signalée (COU-008) ; vide = pas de vérification",
            "items": { "enum": ["intensity", "color", "position", "beam", "effectMotion", "programs", "atmosphere", "control", "other"] }
          },
          "crossFade": {
            "type": "object",
            "required": ["value"],
            "properties": { "value": { "type": "number", "minimum": 0 }, "unit": { "enum": ["seconds", "beats", "bars"] } }
          }
        }
      }
    }
  }
}
