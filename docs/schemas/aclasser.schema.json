{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://luxia.local/schemas/aclasser.schema.json",
  "title": "LuXia – aclasser.json (format 1)",
  "description": "Titres de playlists importées que la base ne sait pas classer (doc 50 §12j, MUS-029). Les titres venus des journaux de soirée ne sont pas enregistrés ici : ils sont relus des fichiers soiree-*.csv.",
  "type": "object",
  "required": ["formatVersion"],
  "properties": {
    "formatVersion": { "const": 1 },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["title"],
        "properties": {
          "artist": { "type": "string" },
          "title": { "type": "string" },
          "app": { "type": "string" },
          "source": { "type": "string", "enum": ["playlist", "journal"] },
          "plays": { "type": "integer", "minimum": 0 }
        }
      }
    }
  }
}